{% comment %}
  Renders facets (filtering and sorting)
{% endcomment %}

<div class="facets-container scroll-trigger animate--fade-in">
  <facet-filters-form class="facets">
    <!-- Mobile Header - Only visible on mobile -->
    <div class="mobile-header">
      <div class="mobile-breadcrumb">
        {% if collection.handle %}
          <span>{{ collection.title }}</span>
        {% endif %}
      </div>
      <div class="product-count">
        {% assign product_count = '#product-grid .grid__item' | count_elements %}
        <span>{{ product_count }} {% if product_count == 1 %}product{% else %}products{% endif %}</span>
      </div>
    </div>

    <div id="FacetsWrapper" class="facets__wrapper">
      <form id="FacetFiltersForm" class="facets__form">
        {%- if results.terms -%}
          <input type="hidden" name="q" value="{{ results.terms | escape }}">
          <input name="options[prefix]" type="hidden" value="last">
        {%- endif -%}

        {% if enable_filtering %}
          <!-- Selected Filters - Visible on both mobile & desktop -->
          <div id="SelectedFilters" class="selected-filters"></div>

          <!-- Mobile View Header -->
          <div class="mobile-facets__header">
            <button type="button" class="mobile-facets__back-button hidden">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M19 12H5M12 19l-7-7 7-7"></path>
              </svg>
              <span>Back</span>
            </button>
            <h2 class="mobile-facets__title">{{ 'products.facets.filter_button' | t }}</h2>
            <button type="button" class="mobile-facets__close-button">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
              </svg>
            </button>
          </div>

          <!-- Filters Content -->
          <div class="facets__content">
            <!-- Desktop Facets -->
            <div class="facets__desktop">
              {% if enable_sorting %}
                <div class="facet-accordion">
                  <details class="facet-accordion__item js-filter" data-index="sort">
                    <summary class="facet-accordion__header">
                      <div class="facet-accordion__label">
                        {{ 'products.facets.sort_by_label' | t }}
                        <span class="facet-accordion__toggle">+</span>
                      </div>
                    </summary>
                    <div class="facet-accordion__content">
                      {%- for option in results.sort_options -%}
                        <div class="facet-checkbox">
                          <input type="radio" 
                            name="sort_by" 
                            value="{{ option.value }}" 
                            id="Sort-{{ option.value }}"
                            {% if option.value == results.sort_by %} checked{% endif %}
                          >
                          <label for="Sort-{{ option.value }}">{{ option.name | escape }}</label>
                        </div>
                      {%- endfor -%}
                    </div>
                  </details>
                </div>
              {% endif %}

              {%- for filter in results.filters -%}
                <div class="facet-accordion">
                  <details class="facet-accordion__item js-filter" data-index="{{ forloop.index }}">
                    <summary class="facet-accordion__header">
                      <div class="facet-accordion__label">
                        {{ filter.label | escape }}
                        <span class="facet-accordion__toggle">+</span>
                      </div>
                    </summary>
                    <div class="facet-accordion__content">
                      {% case filter.type %}
                      {% when 'boolean', 'list' %}
                        <!-- Boolean and List Logic -->
                        <fieldset class="facets-wrap">
                          <legend class="visually-hidden">{{ filter.label | escape }}</legend>
                          <ul class="facet-accordion__list">
                            {%- for value in filter.values -%}
                              <li class="facet-accordion__list-item">
                                <label class="facet-checkbox{% if value.count == 0 and value.active == false %} disabled{% endif %}">
                                  <input type="checkbox"
                                    name="{{ value.param_name }}"
                                    value="{{ value.value }}"
                                    {% if value.active %}checked{% endif %}
                                    {% if value.count == 0 and value.active == false %}disabled{% endif %}
                                  >
                                  <span class="facet-checkbox__text">
                                    {{ value.label | escape }} ({{ value.count }})
                                  </span>
                                </label>
                              </li>
                            {%- endfor -%}
                          </ul>
                        </fieldset>
                    
                      {% when 'price_range' %}
                        <!-- Range Filter Logic -->
                        <div class="facet-range">
                          <input type="number" 
                                 name="min_{{ filter.param_name }}" 
                                 value="{{ filter.min_value }}" 
                                 placeholder="Min" 
                                 class="facet-range__input">
                          <input type="number" 
                                 name="max_{{ filter.param_name }}" 
                                 value="{{ filter.max_value }}" 
                                 placeholder="Max" 
                                 class="facet-range__input">
                        </div>
                    
                      {% when 'color' %}
                        <!-- Color Swatches -->
                        <fieldset class="facets-wrap">
                          <legend class="visually-hidden">{{ filter.label | escape }}</legend>
                          <ul class="facet-accordion__list">
                            {%- for value in filter.values -%}
                              <li class="facet-accordion__list-item">
                                <label class="facet-color{% if value.count == 0 and value.active == false %} disabled{% endif %}">
                                  <input type="checkbox"
                                    name="{{ value.param_name }}"
                                    value="{{ value.value }}"
                                    {% if value.active %}checked{% endif %}
                                    {% if value.count == 0 and value.active == false %}disabled{% endif %}
                                  >
                                  <span class="facet-color__swatch" style="background-color: {{ value.label | escape }}"></span>
                                  <span class="facet-color__label">
                                    {{ value.label | escape }} ({{ value.count }})
                                  </span>
                                </label>
                              </li>
                            {%- endfor -%}
                          </ul>
                        </fieldset>
                    {% endcase %}                    
                    </div>
                  </details>
                </div>
              {%- endfor -%}
            </div>

            <!-- Mobile Facets -->
            <div class="facets__mobile">
              {% if enable_sorting %}
                <div class="facet-accordion__item" data-submenu="sort">
                  <button type="button" class="mobile-facets__menu-button">
                    <span>{{ 'products.facets.sort_by_label' | t }}</span>
                    <svg class="mobile-facets__arrow" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M9 18l6-6-6-6"></path>
                    </svg>
                  </button>
                  <div class="mobile-facets__submenu">
                    {%- for option in results.sort_options -%}
                      <div class="facet-checkbox">
                        <input type="radio" 
                          name="sort_by" 
                          value="{{ option.value }}" 
                          id="Mobile-Sort-{{ option.value }}"
                          {% if option.value == results.sort_by %} checked{% endif %}
                        >
                        <label for="Mobile-Sort-{{ option.value }}">{{ option.name | escape }}</label>
                      </div>
                    {%- endfor -%}
                  </div>
                </div>
              {% endif %}

              {%- for filter in results.filters -%}
                <div class="facet-accordion__item" data-submenu="{{ filter.param_name }}">
                  <button type="button" class="mobile-facets__menu-button">
                    <span>{{ filter.label | escape }}</span>
                    <svg class="mobile-facets__arrow" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M9 18l6-6-6-6"></path>
                    </svg>
                  </button>
                  <div class="mobile-facets__submenu">
                    {% case filter.type %}
                    {% when 'boolean', 'list' %}
                      <!-- Boolean and List Logic -->
                      <fieldset class="facets-wrap">
                        <legend class="visually-hidden">{{ filter.label | escape }}</legend>
                        <ul class="facet-accordion__list">
                          {%- for value in filter.values -%}
                            <li class="facet-accordion__list-item">
                              <label class="facet-checkbox{% if value.count == 0 and value.active == false %} disabled{% endif %}">
                                <input type="checkbox"
                                  name="{{ value.param_name }}"
                                  value="{{ value.value }}"
                                  {% if value.active %}checked{% endif %}
                                  {% if value.count == 0 and value.active == false %}disabled{% endif %}
                                >
                                <span class="facet-checkbox__text">
                                  {{ value.label | escape }} ({{ value.count }})
                                </span>
                              </label>
                            </li>
                          {%- endfor -%}
                        </ul>
                      </fieldset>
                  
                    {% when 'price_range' %}
                      <!-- Range Filter Logic -->
                      <div class="facet-range">
                        <input type="number" 
                               name="min_{{ filter.param_name }}" 
                               value="{{ filter.min_value }}" 
                               placeholder="Min" 
                               class="facet-range__input">
                        <input type="number" 
                               name="max_{{ filter.param_name }}" 
                               value="{{ filter.max_value }}" 
                               placeholder="Max" 
                               class="facet-range__input">
                      </div>
                  
                    {% when 'color' %}
                      <!-- Color Swatches -->
                      <fieldset class="facets-wrap">
                        <legend class="visually-hidden">{{ filter.label | escape }}</legend>
                        <ul class="facet-accordion__list">
                          {%- for value in filter.values -%}
                            <li class="facet-accordion__list-item">
                              <label class="facet-color{% if value.count == 0 and value.active == false %} disabled{% endif %}">
                                <input type="checkbox"
                                  name="{{ value.param_name }}"
                                  value="{{ value.value }}"
                                  {% if value.active %}checked{% endif %}
                                  {% if value.count == 0 and value.active == false %}disabled{% endif %}
                                >
                                <span class="facet-color__swatch" style="background-color: {{ value.label | escape }}"></span>
                                <span class="facet-color__label">
                                  {{ value.label | escape }} ({{ value.count }})
                                </span>
                              </label>
                            </li>
                          {%- endfor -%}
                        </ul>
                      </fieldset>
                  {% endcase %}                  
                  </div>
                </div>
              {%- endfor -%}
            </div>
          </div>

          <!-- Mobile Footer -->
          <div class="mobile-facets__footer">
            <button type="button" class="mobile-facets__clear">
              {{ 'products.facets.clear_all' | t }}
            </button>
            <button type="button" class="mobile-facets__apply">
              {{ 'products.facets.done' | t }}
            </button>
          </div>
        {% endif %}
      </form>
    </div>
  </facet-filters-form>
</div>