{% comment %}
  Renders facets (filtering and sorting)
{% endcomment %}

{%- liquid
  assign sort_by = results.sort_by | default: results.default_sort_by
  assign total_active_values = 0
  assign default_presentation = 'text'
  if results.url
    assign results_url = results.url
  else
    assign terms = results.terms | escape
    assign results_url = '?q=' | append: terms | append: '&options%5Bprefix%5D=last&sort_by=' | append: sort_by
  endif
-%}

<div class="facets-container scroll-trigger animate--fade-in">
     <!-- Desktop Facets -->
    <facet-filters-form class="facets small-hide">
      <form id="FacetFiltersForm" class="facets__form">
        {%- if results.terms -%}
          <input type="hidden" name="q" value="{{ results.terms | escape }}">
          <input name="options[prefix]" type="hidden" value="last">
        {%- endif -%}

        {% if enable_filtering %}
          <div id="FacetsWrapperDesktop" class="facets__wrapper-desktop">
            <div id="SelectedFilters" class="selected-filters"></div>
            {% if enable_sorting %}
              <div class="facet-accordion">
                <details
                  id="Details-SortBy-{{ section.id }}"
                  class="facet-accordion__item js-filter"
                  data-index="sort"
                >
                  <summary class="facet-accordion__header">
                    <div class="facet-accordion__label">
                      {{ 'products.facets.sort_by_label' | t }}
                      <span class="facet-accordion__toggle">+</span>
                    </div>
                  </summary>
                  <div class="facet-accordion__content">
                    <div class="select">
                      <select
                        name="sort_by"
                        class="facet-filters__sort select__select caption-large"
                        id="SortBy"
                        aria-describedby="a11y-refresh-page-message"
                      >
                        {%- for option in results.sort_options -%}
                          <option
                            value="{{ option.value | escape }}"
                            {% if option.value == sort_by %}selected="selected"{% endif %}
                          >
                            {{ option.name | escape }}
                          </option>
                        {%- endfor -%}
                      </select>
                    </div>
                  </div>
                </details>
              </div>
            {% endif %}

            {%- for filter in results.filters -%}
              <div class="facet-accordion">
                <details
                  id="Details-{{ filter.param_name | escape }}-{{ section.id }}"
                  class="facet-accordion__item js-filter"
                  data-index="{{ forloop.index }}"
                >
                  <summary class="facet-accordion__header">
                    <div class="facet-accordion__label">
                      {{ filter.label | escape }}
                      <span class="facet-accordion__toggle">+</span>
                    </div>
                    <div class="facet-accordion__count">
                      {%- if filter.active_values.size > 0 -%}
                        ({{ filter.active_values.size }})
                      {%- endif -%}
                    </div>
                  </summary>

                  <div class="facet-accordion__content">
                    {% case filter.type %}
                      {% when 'boolean' or 'list' %}
                        <fieldset class="facets-wrap">
                          <legend class="visually-hidden">{{ filter.label | escape }}</legend>
                          <ul class="facet-accordion__list">
                            {%- for value in filter.values -%}
                              <li class="facet-accordion__list-item">
                                <label class="facet-checkbox{% if value.count == 0 and value.active == false %} disabled{% endif %}">
                                  <input 
                                    type="checkbox"
                                    name="{{ value.param_name }}"
                                    value="{{ value.value }}"
                                    class="custom-checkbox"
                                    {% if value.active %}checked{% endif %}
                                    {% if value.count == 0 and value.active == false %}disabled{% endif %}
                                  >
                                  <span class="facet-checkbox__text">
                                    {{ value.label | escape }} ({{ value.count }})
                                  </span>
                                </label>
                              </li>
                            {%- endfor -%}
                          </ul>
                        </fieldset>

                      {% when 'price_range' %}
                        <price-range class="facet-accordion__price">
                          {% render 'price-facet',
                            filter: filter,
                            id_prefix: 'Desktop-Filter-',
                            format: 'vertical'
                          %}
                        </price-range>
                    {% endcase %}
                  </div>
                </details>
              </div>
            {%- endfor -%}
          </div>
        {% endif %}
      </form>
    </facet-filters-form>

 <!-- Mobile Menu Drawer -->
<div class="mobile-facets">

  <div class="mobile-header">
    <div class="mobile-breadcrumb">
      {% if collection.handle %}
        <span>{{ collection.title }}</span>
      {% endif %}
    </div>
    <div class="mobile-facets__filter">
      <div class="product-count-mobile">
        {% if collection.all_products_count > 0 %}
          <span>{{ collection.all_products_count }} {% if collection.all_products_count == 1 %}product{% else %}producten{% endif %}</span>
        {% endif %}
      </div>
    </div>
  </div>

  <!-- Drawer Content -->
  <menu-drawer id="MobileMenuDrawer" class="mobile-facets__drawer">
    <!-- Main View -->
    <div class="mobile-facets__main-view">
      <!-- Header -->
      <div class="mobile-facets__header">
        <h2 class="mobile-facets__title">{{ 'products.facets.filter_button' | t }}</h2>
        <button type="button" class="mobile-facets__close-button">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div> 

      <!-- Filter Categories -->
      <div class="mobile-facets__categories">
        {% for filter in results.filters %}
          <button class="mobile-facets__filter-category" data-category-id="{{ filter.param_name }}">
            <span class="mobile-facets__filter-category-label">{{ filter.label }}</span>
            <svg class="mobile-facets__filter-category-arrow" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M9 18l6-6-6-6"/>
            </svg>
          </button>
        {% endfor %}
      </div>

      <!-- Footer -->
      <div class="mobile-facets__footer">
        <button type="button" class="mobile-facets__clear">
          {{ 'products.facets.clear_all' | t }}
        </button>
        <button type="submit" class="mobile-facets__apply">
          {{ 'products.facets.apply' | t }}
        </button>
      </div>
    </div>

    <!-- Category Views -->
    {% for filter in results.filters %}
      <div class="mobile-facets__category-view" data-category="{{ filter.param_name }}" aria-hidden="true">
        <!-- Category Header -->
        <button type="button" class="mobile-facets__back-button">
          <svg class="mobile-facets__back-arrow" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M9 18l6-6-6-6"/>
          </svg>
          <span class="mobile-facets__back-text">{{ filter.label }}</span>
        </button>

        <!-- Filter Options -->
        <div class="mobile-facets__filter-options">
          {% case filter.type %}
            {% when 'boolean' or 'list' %}
              {% for value in filter.values %}
                <label class="mobile-facets__filter-option">
                  <input 
                    type="checkbox"
                    name="{{ value.param_name }}"
                    value="{{ value.value }}"
                    class="mobile-facets__filter-checkbox"
                    {% if value.active %}checked{% endif %}
                    {% if value.count == 0 %}disabled{% endif %}
                  >
                  <span class="mobile-facets__filter-label">
                    {{ value.label }} ({{ value.count }})
                  </span>
                </label>
              {% endfor %}

            {% when 'price_range' %}
              {% render 'price-facet',
                filter: filter,
                id_prefix: 'Mobile-Filter-',
                format: 'horizontal'
              %}
          {% endcase %}
        </div>

        <!-- Category Footer -->
        <div class="mobile-facets__footer">
          <button type="button" class="mobile-facets__clear">
            {{ 'products.facets.clear_all' | t }}
          </button>
          <button type="submit" class="mobile-facets__apply">
            {{ 'products.facets.apply' | t }}
          </button>
        </div>
      </div>
    {% endfor %}
  </menu-drawer>
</div>
</div>