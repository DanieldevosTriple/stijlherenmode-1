{% comment %}
  Renders facets (filtering and sorting)
{% endcomment %}

{%- liquid
  assign sort_by = results.sort_by | default: results.default_sort_by
  assign total_active_values = 0
  assign default_presentation = 'text'
  if results.url
    assign results_url = results.url
  else
    assign terms = results.terms | escape
    assign results_url = '?q=' | append: terms | append: '&options%5Bprefix%5D=last&sort_by=' | append: sort_by
  endif
-%}

<div class="facets-container scroll-trigger animate--fade-in">
  {%- if filter_type == 'vertical' or filter_type == 'horizontal' -%}
    <facet-filters-form class="facets small-hide">
      <form id="FacetFiltersForm" class="facets__form">
        {%- if results.terms -%}
          <input type="hidden" name="q" value="{{ results.terms | escape }}">
          <input name="options[prefix]" type="hidden" value="last">
        {%- endif -%}

        {% if enable_filtering %}
          <div id="FacetsWrapperDesktop" class="facets__wrapper-desktop">
            {% if enable_sorting %}
              <div class="facet-accordion">
                <details
                  id="Details-SortBy-{{ section.id }}"
                  class="facet-accordion__item js-filter"
                  data-index="sort"
                >
                  <summary class="facet-accordion__header">
                    <div class="facet-accordion__label">
                      {{ 'products.facets.sort_by_label' | t }}
                      <span class="facet-accordion__toggle">+</span>
                    </div>
                  </summary>
                  <div class="facet-accordion__content">
                    <div class="select">
                      <select
                        name="sort_by"
                        class="facet-filters__sort select__select caption-large"
                        id="SortBy"
                        aria-describedby="a11y-refresh-page-message"
                      >
                        {%- for option in results.sort_options -%}
                          <option
                            value="{{ option.value | escape }}"
                            {% if option.value == sort_by %}selected="selected"{% endif %}
                          >
                            {{ option.name | escape }}
                          </option>
                        {%- endfor -%}
                      </select>
                    </div>
                  </div>
                </details>
              </div>
            {% endif %}

            {%- for filter in results.filters -%}
              <div class="facet-accordion">
                <details
                  id="Details-{{ filter.param_name | escape }}-{{ section.id }}"
                  class="facet-accordion__item js-filter"
                  data-index="{{ forloop.index }}"
                >
                  <summary class="facet-accordion__header">
                    <div class="facet-accordion__label">
                      {{ filter.label | escape }}
                      <span class="facet-accordion__toggle">+</span>
                    </div>
                    <div class="facet-accordion__count">
                      {%- if filter.active_values.size > 0 -%}
                        ({{ filter.active_values.size }})
                      {%- endif -%}
                    </div>
                  </summary>

                  <div class="facet-accordion__content">
                    {% case filter.type %}
                      {% when 'boolean' or 'list' %}
                        <fieldset class="facets-wrap">
                          <legend class="visually-hidden">{{ filter.label | escape }}</legend>
                          <ul class="facet-accordion__list">
                            {%- for value in filter.values -%}
                              <li class="facet-accordion__list-item">
                                <label class="facet-checkbox{% if value.count == 0 and value.active == false %} disabled{% endif %}">
                                  <input 
                                    type="checkbox"
                                    name="{{ value.param_name }}"
                                    value="{{ value.value }}"
                                    {% if value.active %}checked{% endif %}
                                    {% if value.count == 0 and value.active == false %}disabled{% endif %}
                                  >
                                  <span class="facet-checkbox__text">
                                    {{ value.label | escape }} ({{ value.count }})
                                  </span>
                                </label>
                              </li>
                            {%- endfor -%}
                          </ul>
                        </fieldset>

                      {% when 'price_range' %}
                        <price-range class="facet-accordion__price">
                          {% render 'price-facet',
                            filter: filter,
                            id_prefix: 'Desktop-Filter-',
                            format: 'vertical'
                          %}
                        </price-range>
                    {% endcase %}
                  </div>
                </details>
              </div>
            {%- endfor -%}
          </div>
        {% endif %}
      </form>
    </facet-filters-form>
  {%- endif -%}

 <!-- Mobile Menu Drawer -->
<div class="mobile-menu">
  <!-- Header -->
  <div class="mobile-menu__header">
    <button 
      type="button" 
      class="mobile-menu__open-button" 
      aria-label="{{ 'products.facets.open_filter' | t }}"
    >
      {{ 'products.facets.filter_button' | t }}
    </button>
  </div>

  <!-- Drawer Content -->
  <menu-drawer id="MobileMenuDrawer" class="mobile-menu__drawer">
    <!-- Sorting -->
    {% if enable_sorting %}
    <div class="mobile-menu__sort">
      <label for="SortBy-mobile">{{ 'products.facets.sort_by_label' | t }}</label>
      <select id="SortBy-mobile" class="mobile-menu__select">
        {% for option in results.sort_options %}
        <option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>
          {{ option.name }}
        </option>
        {% endfor %}
      </select>
    </div>
    {% endif %}

    <!-- Filters -->
    <div class="mobile-menu__filters">
      {% for filter in results.filters %}
      <details class="mobile-menu__filter">
        <summary class="mobile-menu__filter-header">{{ filter.label }}</summary>
        <div class="mobile-menu__filter-body">
          {% if filter.type == 'list' or filter.type == 'boolean' %}
          <ul class="mobile-menu__filter-list">
            {% for value in filter.values %}
            <li>
              <label>
                <input 
                  type="checkbox" 
                  name="{{ value.param_name }}" 
                  value="{{ value.value }}" 
                  {% if value.active %}checked{% endif %}
                  {% if value.count == 0 %}disabled{% endif %}
                >
                {{ value.label }} ({{ value.count }})
              </label>
            </li>
            {% endfor %}
          </ul>
          {% endif %}
        </div>
      </details>
      {% endfor %}
    </div>

    <!-- Footer Buttons -->
    <div class="mobile-menu__footer">
      <a href="{{ results_url }}" class="mobile-menu__clear button button--tertiary">
        {{ 'products.facets.clear_all' | t }}
      </a>
      <button type="submit" class="mobile-menu__apply button button--primary">
        {{ 'products.facets.apply' | t }}
      </button>
    </div>
  </menu-drawer>
</div>
</div>