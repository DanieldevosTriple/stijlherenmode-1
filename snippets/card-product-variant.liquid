{% comment %}
    Renders a product card with CSS-only image carousel functionality
    No JavaScript required
{% endcomment %}

{{ 'component-rating.css' | asset_url | stylesheet_tag }}
{{ 'product-card-carousel.css' | asset_url | stylesheet_tag }}
{{ 'https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css' | stylesheet_tag }}
{{ 'https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js' | script_tag }}

{%- if variant and variant != empty -%}
  {%- liquid
    assign ratio = 1
    assign variant_color = variant.options | first
    assign variant_color_downcase = variant_color | downcase
    assign variant_images = card_product.media | where: 'alt', variant_color_downcase
  -%}
    <!-- product-card-carousel.liquid -->
  <div class="product-card">
    <div class="swiper product-card-media-slider" id="slider-{{ variant.id }}">
      <div class="swiper-wrapper">
        {%- if variant.featured_media -%}
          <div class="swiper-slide">
            <img
              srcset="{{ variant.featured_media | img_url: 'master' }} {{ variant.featured_media.width }}w"
              src="{{ variant.featured_media | img_url: '533x' }}"
              alt="{{ variant.featured_media.alt | escape }}"
              loading="lazy"
              width="{{ variant.featured_media.width }}"
              height="{{ variant.featured_media.height }}"
            >
          </div>
        {%- endif -%}
        
        {% for media_item in card_product.media %}
          {% assign alt_text_lowercase = media_item.alt | downcase %}
          {% if alt_text_lowercase contains 'color |' %}
            {% assign alt_color_part = alt_text_lowercase | split: 'color |' | last | strip %}
            {% if alt_color_part == variant_color_downcase %}
              <div class="swiper-slide">
                <img
                  srcset="{{ media_item | img_url: 'master' }} {{ media_item.width }}w"
                  src="{{ media_item | img_url: '533x' }}"
                  alt="{{ media_item.alt | escape }}"
                  loading="lazy"
                  width="{{ media_item.width }}"
                  height="{{ media_item.height }}"
                >
              </div>
            {% endif %}
          {% endif %}
        {% endfor %}
      </div>
      
      <!-- Navigation arrows -->
      <div class="swiper-button-prev"></div>
      <div class="swiper-button-next"></div>
      
      <!-- Pagination dots -->
      <div class="swiper-pagination"></div>
    </div>
  </div>

      <!-- Rest of the card content remains the same -->
      <div class="card__content">
        <div class="card__information">
          <h3 class="card__heading{% if card_product.featured_media or settings.card_style == 'standard' %} h5{% endif %}">
            <a href="{{ card_product.url }}?variant={{ variant.id }}" class="full-unstyled-link">
              {{ card_product.title | escape }} - {{ variant.options | first }}
            </a>
          </h3>
          <div class="card-information">
            {%- if show_vendor -%}
              <span class="visually-hidden">{{ 'accessibility.vendor' | t }}</span>
              <div class="caption-with-letter-spacing light">{{ card_product.vendor }}</div>
            {%- endif -%}

            <span class="caption-large light">{{ block.settings.description | escape }}</span>

            {% render 'price', product: variant, price_class: '' %}
          </div>
        </div>
      </div>
{%- endif -%}

<script>
  document.addEventListener('DOMContentLoaded', function() {
    function initSwiper() {
      const swipers = document.querySelectorAll('.product-card-media-slider');
      
      swipers.forEach(element => {
        // Only initialize if more than one slide
        const slides = element.querySelectorAll('.swiper-slide');
        if (slides.length <= 1) return;
        
        new Swiper(element, {
          loop: true,
          grabCursor: true,
          
          // Navigation arrows
          navigation: {
            nextEl: '.swiper-button-next',
            prevEl: '.swiper-button-prev',
          },
          
          // Pagination dots
          pagination: {
            el: '.swiper-pagination',
            clickable: true,
          },
          
          // Better mobile handling
          touchEventsTarget: 'wrapper',
          touchRatio: 1,
          touchAngle: 45,
          
          // Improved performance
          observer: true,
          observeParents: true
        });
      });
    }
    
    // Initialize on load
    initSwiper();
    
    // Re-initialize after faceted navigation updates
    document.addEventListener('facets:updated', function() {
      setTimeout(initSwiper, 0);
    });
  });
  </script>