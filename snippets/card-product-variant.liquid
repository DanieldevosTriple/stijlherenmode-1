{% comment %}
    Renders a product card with CSS-only image carousel functionality
    - Implements optimal image loading strategies
    - Uses CSS-only carousel functionality for better performance
    - No JavaScript required
    - Implements proper lazy loading and image optimization
{% endcomment %}

{{ 'component-rating.css' | asset_url | stylesheet_tag }}
{{ 'product-card-carousel.css' | asset_url | stylesheet_tag }}

{%- if variant and variant != empty -%}
  {%- liquid
    # Basic assignments
    assign ratio = 1
    assign variant_color = variant.options | first
    assign variant_color_downcase = variant_color | downcase
    assign variant_images = card_product.media | where: 'alt', variant_color_downcase
    
    # Calculate optimal image dimensions
    assign max_width = 1066
    assign default_width = 533
    assign card_width = settings.page_width | minus: 130 | divided_by: 4
    assign mobile_width = "calc((100vw - 35px) / 2)"
    assign tablet_width = "calc((100vw - 120px) / 3)"
    assign desktop_width = card_width | append: 'px'
    
    # Optimize image dimensions
    assign img_width = default_width | at_most: max_width
    assign img_height = img_width | divided_by: ratio | round
  -%}

  <div class="product-card" style="contain: layout style;">
    <div class="product-card-media-slider" id="slider-{{ variant.id }}">
      <div class="slider-wrapper" style="scroll-snap-type: x mandatory; overflow-x: auto; display: flex; -webkit-overflow-scrolling: touch;">
        {%- if variant.featured_media -%}
          <div class="slide" style="scroll-snap-align: start; flex: 0 0 100%;">
            <a href="{{ card_product.url }}?variant={{ variant.id }}" class="product-link">
              <img
                srcset="{{ variant.featured_media | img_url: '360x' }} 360w,
                        {{ variant.featured_media | img_url: '533x' }} 533w,
                        {{ variant.featured_media | img_url: '720x' }} 720w"
                sizes="(min-width: {{ settings.page_width }}px) {{ desktop_width }},
                       (min-width: 990px) {{ tablet_width }},
                       {{ mobile_width }}"
                src="{{ variant.featured_media | img_url: default_width | append: 'x' }}"
                alt="{{ variant.featured_media.alt | escape }}"
                class="product-card-carousel-image"
                loading="eager"
                fetchpriority="high"
                width="{{ img_width }}"
                height="{{ img_height }}"
                style="aspect-ratio: {{ ratio }}; object-fit: cover;"
                onerror="this.onerror=null; this.src='{{ variant.featured_media | img_url: default_width | append: 'x' }}';"
              >
            </a>
          </div>
        {%- endif -%}

        {% for media_item in card_product.media %}
          {% assign alt_text_lowercase = media_item.alt | downcase %}
          {% if alt_text_lowercase contains 'color |' %}
            {% assign alt_color_part = alt_text_lowercase | split: 'color |' | last | strip %}
            {% if alt_color_part == variant_color_downcase %}
              <div class="slide" style="scroll-snap-align: start; flex: 0 0 100%;">
                <a href="{{ card_product.url }}?variant={{ variant.id }}" class="product-link">
                  <img
                    srcset="{{ media_item | img_url: '360x' }} 360w,
                            {{ media_item | img_url: '533x' }} 533w,
                            {{ media_item | img_url: '720x' }} 720w"
                    sizes="(min-width: {{ settings.page_width }}px) {{ desktop_width }},
                           (min-width: 990px) {{ tablet_width }},
                           {{ mobile_width }}"
                    src="{{ media_item | img_url: default_width | append: 'x' }}"
                    alt="{{ media_item.alt | escape }}"
                    class="product-card-carousel-image"
                    loading="lazy"
                    width="{{ img_width }}"
                    height="{{ img_height }}"
                    style="aspect-ratio: {{ ratio }}; object-fit: cover;"
                    onerror="this.onerror=null; this.src='{{ media_item | img_url: default_width | append: 'x' }}';"
                  >
                </a>
              </div>

              {% if forloop.first %}
                <link rel="preload" as="image" href="{{ media_item | img_url: default_width | append: 'x' }}">
              {% endif %}
            {% endif %}
          {% endif %}
        {% endfor %}
      </div>
      
      <div class="slider-nav" style="display: flex; justify-content: space-between; align-items: center; padding: 0.5rem;">
        <button class="prev" aria-label="Previous image" style="cursor: pointer;">&lt;</button>
        <div class="dots" role="tablist" style="display: flex; gap: 0.5rem;">
          {% for media_item in variant_images %}
            <button 
              role="tab"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              aria-label="Go to slide {{ forloop.index }}"
              class="dot{% if forloop.first %} active{% endif %}"
              style="width: 8px; height: 8px; border-radius: 50%; background: {% if forloop.first %}currentColor{% else %}#00000040{% endif %};"
            ></button>
          {% endfor %}
        </div>
        <button class="next" aria-label="Next image" style="cursor: pointer;">&gt;</button>
      </div>
    </div>

    <div class="card__content">
      <div class="card__information">
        <h3 class="card__heading{% if card_product.featured_media or settings.card_style == 'standard' %} h5{% endif %}">
          <a href="{{ card_product.url }}?variant={{ variant.id }}" class="full-unstyled-link">
            {{ card_product.title | escape }} - {{ variant.options | first }}
          </a>
        </h3>
        <div class="card-information">
          {%- if show_vendor -%}
            <span class="visually-hidden">{{ 'accessibility.vendor' | t }}</span>
            <div class="caption-with-letter-spacing light">{{ card_product.vendor }}</div>
          {%- endif -%}

          <span class="caption-large light">{{ block.settings.description | escape }}</span>

          {% render 'price', product: variant, price_class: '' %}
        </div>
      </div>
    </div>
  </div>
{%- endif -%}