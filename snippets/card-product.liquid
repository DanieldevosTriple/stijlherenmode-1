{% comment %}
    Renders a product card with optimized image loading
    - Implements priority loading for visible images
    - Uses appropriate srcset and sizes
    - Implements proper lazy loading
    - Uses specific image dimensions
    - Implements proper preloading for carousel images
{% endcomment %}

{{ 'component-rating.css' | asset_url | stylesheet_tag }}
{{ 'product-card-carousel.css' | asset_url | stylesheet_tag }}
{{ 'product-card-carousel.js' | asset_url | script_tag }}

{%- liquid
  assign ratio = 1
  assign variant_color = variant.options | first
  assign variant_color_downcase = variant_color | downcase
  assign variant_images = card_product.media | where: 'alt', variant_color_downcase
  
  # Calculate optimal image dimensions based on container
  assign card_width = settings.page_width | minus: 130 | divided_by: 4
  assign mobile_width = "calc((100vw - 35px) / 2)"
  assign tablet_width = "calc((100vw - 120px) / 3)"
  assign desktop_width = card_width | append: 'px'
-%}

<div class="product-card">
  <div class="product-card-media-slider" id="slider-{{ variant.id }}">
    {%- if card_product.featured_media -%}
      <div class="slider-wrapper">
        {%- for media in card_product.media -%}
          <div class="slide" data-slide="{{ forloop.index0 }}">
            <a href="{{ card_product.url }}?variant={{ variant.id }}" class="product-link">
              {%- assign img_width = media.width | at_most: 1066 -%}
              {%- assign img_height = img_width | divided_by: ratio | round -%}
              
              <img
                srcset="{%- if media.width >= 165 -%}{{ media | img_url: '165x' }} 165w,{%- endif -%}
                {%- if media.width >= 360 -%}{{ media | img_url: '360x' }} 360w,{%- endif -%}
                {%- if media.width >= 533 -%}{{ media | img_url: '533x' }} 533w,{%- endif -%}
                {%- if media.width >= 720 -%}{{ media | img_url: '720x' }} 720w,{%- endif -%}
                {%- if media.width >= 940 -%}{{ media | img_url: '940x' }} 940w,{%- endif -%}
                {{ media | img_url: 'master' }} {{ media.width }}w"
                sizes="(min-width: {{ settings.page_width }}px) {{ desktop_width }},
                       (min-width: 990px) {{ tablet_width }},
                       (min-width: 750px) {{ tablet_width }},
                       {{ mobile_width }}"
                src="{{ media | img_url: '533x' }}"
                alt="{{ media.alt | escape }}"
                class="motion-reduce product-card-carousel-image"
                {% if forloop.first %}
                  loading="eager"
                  fetchpriority="high"
                {% else %}
                  loading="lazy"
                {% endif %}
                width="{{ img_width }}"
                height="{{ img_height }}"
                style="aspect-ratio: {{ ratio }}">
            </a>
          </div>

          {% if forloop.first %}
            {%- # Preload next image for faster carousel transition -%}
            <link rel="preload" as="image" href="{{ media | img_url: '533x' }}">
          {% endif %}
        {%- endfor -%}
      </div>
    {% endif %}

    <div class="slider-nav">
      <button class="prev" aria-label="Previous image">&lt;</button>
      <div class="dots"></div>
      <button class="next" aria-label="Next image">&gt;</button>
    </div>
  </div>

  <div class="card__content">
    <div class="card__information">
      <h3 class="card__heading{% if card_product.featured_media or settings.card_style == 'standard' %} h5{% endif %}">
        <a href="{{ card_product.url }}?variant={{ variant.id }}" class="full-unstyled-link">
          {{ card_product.title | escape }} - {{ variant.options | first }}
        </a>
      </h3>
      <div class="card-information">
        {%- if show_vendor -%}
          <span class="visually-hidden">{{ 'accessibility.vendor' | t }}</span>
          <div class="caption-with-letter-spacing light">{{ card_product.vendor }}</div>
        {%- endif -%}

        <span class="caption-large light">{{ block.settings.description | escape }}</span>
        {% render 'price', product: variant, price_class: '' %}
      </div>
    </div>
  </div>
</div>