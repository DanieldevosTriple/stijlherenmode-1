{{ 'template-collection.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'custom-product-collection.css' | asset_url | stylesheet_tag }}

<script>
  window.products = {};
  {% for product in collections.all.products %}
    window.products[{{ product.id }}] = {
      "id": {{ product.id }},
      "title": "{{ product.title }}",
      "variants": [
        {% for variant in product.variants %}
          {
            "id": {{ variant.id }},
            "color": "{{ variant.option1 }}",
            "image": "{{ variant.image | img_url: 'medium' }}"
          }
          {% unless forloop.last %},{% endunless %}
        {% endfor %}
      ]
    };
  {% endfor %}
</script>

<script>
  window.products = {};
  let debugInfo = {
    allProducts: [],
    productsWithVariants: [],
    productsWithColorVariants: [],
    colorOptionAnalysis: []
  };
  
  {% for product in collections.sale.products %}
    // Track ALL products with their option info
    let productOptions = [{% for option in product.options %}"{{ option | strip }}"{% unless forloop.last %},{% endunless %}{% endfor %}];
    
    debugInfo.colorOptionAnalysis.push({
      id: {{ product.id }},
      title: "{{ product.title }}",
      options: productOptions,
      rawOptions: [{% for option in product.options %}"{{ option }}"{% unless forloop.last %},{% endunless %}{% endfor %}],
      firstOptionType: "{{ product.options.first }}",
      hasVariants: {% if product.variants.size > 0 %}true{% else %}false{% endif %},
      variantCount: {{ product.variants.size }},
      firstVariantOption1: "{{ product.variants.first.option1 }}"
    });
  
    {% if product.variants.size > 0 %}
      debugInfo.productsWithVariants.push({
        id: {{ product.id }},
        title: "{{ product.title }}",
        options: productOptions,
        variantCount: {{ product.variants.size }}
      });
      
      // Check if product has color option (with detailed logging)
      {% assign has_color = false %}
      {% for option in product.options %}
        {% assign stripped_option = option | strip %}
        {% if stripped_option == 'Color' or stripped_option == 'Kleur' %}
          {% assign has_color = true %}
          debugInfo.productsWithColorVariants.push({
            id: {{ product.id }},
            title: "{{ product.title }}",
            colorOptionIndex: {{ forloop.index0 }},
            allOptions: productOptions,
            rawColorOption: "{{ option }}",
            strippedColorOption: "{{ stripped_option }}"
          });
        {% endif %}
      {% endfor %}
    {% endif %}
  
    window.products[{{ product.id }}] = {
      "id": {{ product.id }},
      "title": "{{ product.title }}",
      "options": productOptions,
      "variants": [
        {% for variant in product.variants %}
          {
            "id": {{ variant.id }},
            "color": "{{ variant.option1 }}",
            "image": "{{ variant.image | img_url: 'medium' }}"
          }
          {% unless forloop.last %},{% endunless %}
        {% endfor %}
      ]
    };
  {% endfor %}
  
  // Detailed analysis logs
  console.log('Basic counts:', {
    'Total Products': debugInfo.allProducts.length,
    'Products with variants': debugInfo.productsWithVariants.length,
    'Products with color variants': debugInfo.productsWithColorVariants.length
  });
  
  // Find products that have "Color" in options but aren't in colorVariants
  const missingColorProducts = debugInfo.colorOptionAnalysis.filter(product => 
    product.options.some(opt => opt.includes('Color')) && 
    !debugInfo.productsWithColorVariants.find(p => p.id === product.id)
  );
  
  console.log('Products with "Color" option but not in color variants:', missingColorProducts);
  
  // Check for whitespace issues
  console.log('Option Analysis:', debugInfo.colorOptionAnalysis.map(p => ({
    id: p.id,
    title: p.title,
    options: p.options,
    rawOptions: p.rawOptions // This will show any extra whitespace
  })));
  
  // Log products that might have color variants but aren't being caught
  const potentialColorProducts = debugInfo.colorOptionAnalysis.filter(p => 
    p.firstOptionType.toLowerCase().includes('color') || 
    p.firstVariantOption1.match(/^(Black|White|Blue|Red|Green|Yellow|Purple|Pink|Brown|Grey|Gray)/i)
  );
  
  console.log('Potential color products that might be missed:', potentialColorProducts);
  </script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- comment -%}Debug info{%- endcomment -%}
<div style="display: none" data-debug>
  Collection size: {{ collections.all.products.size }}
  Current template: {{ template }}
  Collection handle: {{ collection.handle }}
</div>

<section class="section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }}">
  {%- paginate collection.products by section.settings.products_per_page -%}

    <div class="col-12 vertical-facets">
      {{ 'component-facets.css' | asset_url | stylesheet_tag }}
      <script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
      {%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
        <aside
          aria-labelledby="verticalTitle"
          class="facets-wrapper{% unless section.settings.enable_filtering %} facets-wrapper--no-filters{% endunless %}"
          id="main-collection-filters"
          data-id="{{ section.id }}"
        >
          {% render 'facets',
            results: collection,
            enable_filtering: section.settings.enable_filtering,
            enable_sorting: section.settings.enable_sorting,
            filter_type: section.settings.filter_type,
            paginate: paginate
          %}
        </aside>
      {%- endif -%}

      <div
        class="product-grid-container"
        id="ProductGridContainer"
      >
        {%- if collection.products.size == 0 -%}
          <div class="collection collection--empty" id="product-grid" data-id="{{ section.id }}">
            <div class="title-wrapper center">
              <h2 class="title title--primary">
                {{ 'sections.collection_template.empty' | t -}}
                <br>
                {{
                  'sections.collection_template.use_fewer_filters_html'
                  | t: link: collection.url, class: 'underlined-link link'
                }}
              </h2>
            </div>
          </div>
        {%- else -%}
          <div class="collection">
            <div
              id="product-grid"
              data-id="{{ section.id }}"
              class="product-grid">
              
              {% for product in collection.products %}
                {%- comment -%}
                  Determine if the product has variants.
                  Instead of directly assigning a boolean with a condition, we use if/else.
                {%- endcomment -%}
                {% if product.variants.size > 0 %}
                  {% assign has_variants = true %}
                {% else %}
                  {% assign has_variants = false %}
                {% endif %}
              
                {%- comment -%}
                  Identify if a 'Color' option exists and store its index.
                {%- endcomment -%}
                {% assign color_option_index = -1 %}
                {% assign color_active = false %}
                {% for opt_name in product.options %}
                  {% if opt_name == 'Color' or opt_name == 'Kleur' %}
                    {% assign color_active = true %}
                    {% assign color_option_index = forloop.index0 %}
                  {% endif %}
                {% endfor %}                
              
                {%- comment -%}
                  If the product has variants and a color option,
                  we want to show one variant per unique color.
                  To avoid issues with 'contains', we wrap each color in a unique delimiter.
                {%- endcomment -%}
                {% if has_variants and color_active and color_option_index != -1 %}
                  {% assign colorlist = '|' %}
                  {% for variant in product.variants %}
                    {% assign color = variant.options[color_option_index] | strip %}
              
                    {%- comment -%}
                      Check if this color is not yet displayed:
                      We search for "|Color|" in colorlist to ensure exact matches.
                    {%- endcomment -%}
                    {% assign color_check = '|' | append: color | append: '|' %}

                      {% if color != '' and colorlist contains color_check %}
                        {%- comment -%}
                          If the color is already in colorlist, skip this variant.
                        {%- endcomment -%}
                        {% continue %}
                      {% endif %}
              
                    {%- comment -%}
                      Show variant for this unique color.
                    {%- endcomment -%}
                    <div class="product-article"
                      data-product-id="{{ product.id }}"
                      data-variant-id="{{ variant.id }}"
                      data-price="{{ variant.price | money_without_currency }}"
                      data-filter-color="{{ variant.options[color_option_index] | escape }}"
                      data-filter-size="{% if product.options.size > 1 %}{{ variant.options.last | escape }}{% endif %}">
                      
                      {% render 'card-product-variant',
                        card_product: product,
                        variant: variant,
                        media_aspect_ratio: section.settings.image_ratio,
                        show_secondary_image: section.settings.show_secondary_image,
                        show_vendor: section.settings.show_vendor,
                        show_rating: section.settings.show_rating
                      %}
                    </div> 
              
                    {%- comment -%}
                      Append this color to the list with delimiters to avoid partial matches.
                    {%- endcomment -%}
                    {% assign colorlist = colorlist | append: color | append: '|' %}
                  {% endfor %}
              
                {%- else -%}
                  {%- comment -%}
                    If there are no color variants or no variants at all, just render the product card.
                  {%- endcomment -%}
                  <div class="product-article"
                    data-product-id="{{ product.id }}">
                    
                    {% render 'card-product',
                      card_product: product,
                      media_aspect_ratio: section.settings.image_ratio,
                      show_secondary_image: section.settings.show_secondary_image,
                      show_vendor: section.settings.show_vendor,
                      show_rating: section.settings.show_rating
                    %}
                  </div>
                {% endif %}
              {% endfor %}                                                       

            </div>    
                         
            {%- if paginate.pages > 1 -%}
              {% render 'pagination', paginate: paginate, anchor: '' %}
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  {%- endpaginate -%}
</section>

{% schema %}
{
  "name": "t:sections.main-collection-product-grid.name",
  "class": "section",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 36,
      "step": 4,
      "default": 16,
      "label": "t:sections.main-collection-product-grid.settings.products_per_page.label"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 4,
      "label": "t:sections.main-collection-product-grid.settings.columns_desktop.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "info": "t:sections.all.colors.has_cards_info",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.main-collection-product-grid.settings.header__3.content"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.main-collection-product-grid.settings.image_ratio.options__1.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.main-collection-product-grid.settings.image_ratio.options__2.label"
        },
        {
          "value": "square",
          "label": "t:sections.main-collection-product-grid.settings.image_ratio.options__3.label"
        }
      ],
      "default": "adapt",
      "label": "t:sections.main-collection-product-grid.settings.image_ratio.label"
    },
    {
      "type": "select",
      "id": "image_shape",
      "options": [
        {
          "value": "default",
          "label": "t:sections.all.image_shape.options__1.label"
        },
        {
          "value": "arch",
          "label": "t:sections.all.image_shape.options__2.label"
        },
        {
          "value": "blob",
          "label": "t:sections.all.image_shape.options__3.label"
        },
        {
          "value": "chevronleft",
          "label": "t:sections.all.image_shape.options__4.label"
        },
        {
          "value": "chevronright",
          "label": "t:sections.all.image_shape.options__5.label"
        },
        {
          "value": "diamond",
          "label": "t:sections.all.image_shape.options__6.label"
        },
        {
          "value": "parallelogram",
          "label": "t:sections.all.image_shape.options__7.label"
        },
        {
          "value": "round",
          "label": "t:sections.all.image_shape.options__8.label"
        }
      ],
      "default": "default",
      "label": "t:sections.all.image_shape.label",
      "info": "t:sections.all.image_shape.info"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "default": false,
      "label": "t:sections.main-collection-product-grid.settings.show_secondary_image.label"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "default": false,
      "label": "t:sections.main-collection-product-grid.settings.show_vendor.label"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "default": false,
      "label": "t:sections.main-collection-product-grid.settings.show_rating.label",
      "info": "t:sections.main-collection-product-grid.settings.show_rating.info"
    },
    {
      "type": "header",
      "content": "t:sections.main-collection-product-grid.settings.header__1.content"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "default": true,
      "label": "t:sections.main-collection-product-grid.settings.enable_filtering.label",
      "info": "t:sections.main-collection-product-grid.settings.enable_filtering.info"
    },
    {
      "type": "select",
      "id": "filter_type",
      "options": [
        {
          "value": "horizontal",
          "label": "t:sections.main-collection-product-grid.settings.filter_type.options__1.label"
        },
        {
          "value": "drawer",
          "label": "t:sections.main-collection-product-grid.settings.filter_type.options__3.label"
        }
      ],
      "default": "horizontal",
      "label": "t:sections.main-collection-product-grid.settings.filter_type.label",
      "info": "t:sections.main-collection-product-grid.settings.filter_type.info"
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "default": true,
      "label": "t:sections.main-collection-product-grid.settings.enable_sorting.label"
    },
    {
      "type": "header",
      "content": "t:sections.main-collection-product-grid.settings.header_mobile.content"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "default": "2",
      "label": "t:sections.main-collection-product-grid.settings.columns_mobile.label",
      "options": [
        {
          "value": "1",
          "label": "t:sections.main-collection-product-grid.settings.columns_mobile.options__1.label"
        },
        {
          "value": "2",
          "label": "t:sections.main-collection-product-grid.settings.columns_mobile.options__2.label"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
