{{ 'two-columns-overlay.css' | asset_url | stylesheet_tag }}

<section>
  <div class="container-fluid section-padding section-padding">
    <ul class="image-overlay-list">
      {% for block in section.blocks %}
      <li>
        <div class="image-overlay-block">
          {% if block.settings.media_type == 'image' %}
            {% if block.settings.image != blank %}
            <div class="image-overlay-block__image"
              style="background-image: url({{ block.settings.image | image_url }}); background-size: cover; background-position: center;">
            </div>
            {% endif %}
          {% else %}
            {% if block.settings.video_url != blank %}
            <div class="image-overlay-block__video">
              <video 
                autoplay 
                loop 
                muted 
                playsinline
                preload="auto"
                defaultMuted
                webkit-playsinline>
                <source src="{{ block.settings.video_url }}" type="video/mp4">
              </video>
            </div>
            {% endif %}
          {% endif %}
          <div class="image-overlay-block__content text-center">
            {% if block.settings.title != blank %}
            <h3 class="image-overlay-block__title">{{ block.settings.title }}</h3>
            {% endif %}
          </div>
        </div>
        {% if block.settings.subtitle != blank %}
        <h3 class="image-overlay-block__subtitle">{{ block.settings.subtitle }}</h3>
        <a href="{{ block.settings.link }}" class="underline">{{ block.settings.linktitle }}</a>
        {% endif %}
      </li>
      {% endfor %}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Two Grid Nav",
  "settings": [],
  "blocks": [
    {
      "type": "block",
      "name": "Block",
      "settings": [
        {
          "type": "select",
          "id": "media_type",
          "label": "Media Type",
          "options": [
            {
              "value": "image",
              "label": "Image"
            },
            {
              "value": "video",
              "label": "Video"
            }
          ],
          "default": "image"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Select when Media Type is Image"
        },
        {
          "type": "url",
          "id": "video_url",
          "label": "Video URL",
          "info": "Enter Shopify CDN video URL (e.g., https://cdn.shopify.com/videos/...)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "linktitle",
          "label": "Shop now"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Two Grid Collections"
    }
  ]
}
{% endschema %}