{{ 'collection-navigation.css' | asset_url | stylesheet_tag }}

<section class="col-12 logo-grid-section">
  <h2 class="title-brands">{{ section.settings.title }}</h2>
  <ul class="logo-grid">
    {% for block in section.blocks %}
      {% assign collection = block.settings.collection %}
      {% if collection %}
        {% assign collection_obj = collections[collection] %}
        <li class="col-3 col-md-3 logo-grid-item" style="background-image: url({{ block.settings.background_image | file_url | replace: 'files/files', 'files' }});">
          <a href="{{ collection_obj.url }}" style="display: block; width: 100%; height: 100%;">
            {% if block.settings.logo_image %}
              <img class="logo_image_url" src="{{ block.settings.logo_image | file_url | replace: 'files/files', 'files' }}" width="" height="" alt="{{ collection_obj.title }}">
            {% endif %}
          </a>
        </li>             
      {% endif %}
    {% endfor %}
  </ul>
</section>

{% schema %}
{
  "name": "Brand Logo Grid",
  "settings": [
    {
      "id": "title",
      "type": "text",
      "label": "Section Title",
      "default": "Our Brands"
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "id": "background_image",
          "type": "image_picker",
          "label": "Background Image"
        },
        {
          "id": "logo_image",
          "type": "image_picker",
          "label": "Logo Image (SVG or PNG)"
        },
        {
          "id": "collection",
          "type": "collection",
          "label": "Select a Collection"
        }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "Brand Logos",
      "settings": {
        "title": "Shop by Brand"
      },
      "blocks": [
        {
          "type": "logo",
          "settings": {
            "background_image": "",
            "logo_image": "",
            "collection": ""
          }
        },
        {
          "type": "logo",
          "settings": {
            "background_image": "",
            "logo_image": "",
            "collection": ""
          }
        }
      ]
    }
  ]
}
{% endschema %}
