<link rel="stylesheet" href="{{ 'component-search.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'header.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'component-mega-menu.css' | asset_url }}" media="print" onload="this.media='all'">

{%- style -%}
:root {
    --logo-light: url('{{ settings.logo_black | file_url | prepend: "https:" | replace: "files/files/", "files/" }}');
    --logo-dark: url('{{ settings.logo_white | file_url | prepend: "https:" | replace: "files/files/", "files/" }}');
}
{%- endstyle -%}

<script>
  var emptyCartIconUrl = "{{ 'icon-cart-empty.svg' | asset_url }}";
  var fullCartIconUrl = "{{ 'icon-cart.svg' | asset_url }}";
</script>
<script src="{{ 'slider-title.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'real-time-cart.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'mega-menu.js' | asset_url }}" defer="defer"></script>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const hamburgerMenu = document.querySelector('.hamburger-menu');
    const mobileMenuOverlay = document.querySelector('.mobile-menu-overlay');
    const closeMenuButton = document.querySelector('.close-menu');
    const body = document.body; // Selecteer de body
  
    // Toon het menu-overlay en sluitknop bij klikken op de hamburger
    hamburgerMenu.addEventListener('click', function () {
      mobileMenuOverlay.classList.add('show');
      closeMenuButton.classList.add('show');
      hamburgerMenu.classList.add('hidden'); // Verberg de hamburger-icon
      body.classList.add('no-scroll'); // Voorkom scrollen
    });
  
    // Verberg het menu-overlay en sluitknop bij klikken op de sluitknop
    closeMenuButton.addEventListener('click', function () {
      mobileMenuOverlay.classList.remove('show');
      closeMenuButton.classList.remove('show');
      hamburgerMenu.classList.remove('hidden'); // Toon de hamburger-icon
      body.classList.remove('no-scroll'); // Schakel scrollen weer in
    });
  
    // Sluit het menu als er buiten de menu-items wordt geklikt
    mobileMenuOverlay.addEventListener('click', function (e) {
      if (e.target === mobileMenuOverlay) {
        mobileMenuOverlay.classList.remove('show');
        closeMenuButton.classList.remove('show');
        hamburgerMenu.classList.remove('hidden'); // Toon de hamburger-icon
        body.classList.remove('no-scroll'); // Schakel scrollen weer in
      }
    });
  });   
</script>

<script>
    document.addEventListener('DOMContentLoaded', function() {
      const header = document.querySelector('header');
      const utilityBar = document.querySelector('.utility-bar');
      
      function setElementHeight() {
        if (header) {
          document.documentElement.style.setProperty('--header-height', `${header.offsetHeight}px`);
        }
        if (utilityBar) {
          document.documentElement.style.setProperty('--utility-bar-height', `${utilityBar.offsetHeight}px`);
        }
      }
    
      // Set initial heights
      setElementHeight();
    
      // Update on window resize
      window.addEventListener('resize', setElementHeight);
    });
</script>
  

{% if section.settings.sticky %}
    <script src="{{ 'dynamic-header-desktop.js' | asset_url }}" defer></script>
{% else %}
  <script>
    console.log('Sticky instelling is niet actief.');
  </script>
{% endif %}

<sticky-header
  data-sticky-enabled="{{ section.settings.sticky }}"
  data-theme-mode="{{ section.settings.header_theme_mode }}"
  class="header-wrapper gradient {% if section.settings.transparent %}{{ template }}-page{% endif %}"
  data-section-type="header">

  {% if section.settings.announcement_bar %}
    <div class="utility-bar color-{{ section.settings.color_scheme }}" data-section-type="announcement-bar">
      <div class="utility-bar__grid">
        <div class="announcement-bar{% if section.settings.show_social %} announcement-bar--one-announcement{% endif %}" role="region" aria-label="{{ 'sections.header.announcement' | t }}" {{ block.shopify_attributes }}>
          {%- if section.settings.announcement_text != blank -%}
            {%- if section.settings.announcement_link != blank -%}
              <a href="{{ section.settings.announcement_link }}" class="announcement-bar__link link link--text focus-inset animate-arrow">
            {%- endif -%}
            <p class="h5 announcement-bar__message">
              <span>{{ section.settings.announcement_text | escape }}</span>
            </p>
            {%- if section.settings.announcement_link != blank -%}
              </a>
            {%- endif -%}
          {%- endif -%}
        </div>
      </div>
    </div>
  {% endif %}

  <header class="header-wrapper">
      <div class="new-header">
        <!-- Left: Dynamic Menu -->
        <div class="col-menu col-align-left menu-items first-menu">
          <!-- Change this part in the desktop navigation -->
          <nav class="navbar navbar-expand-lg d-none d-lg-block">
            {% if section.settings.menu != blank %}
              {% assign menu = linklists[section.settings.menu] %}
              <ul class="navbar-nav">
                {% for link in menu.links %}
                  <li class="nav-item {% if link.links.size > 0 and section.settings.enable_mega_menu %}has-megamenu{% endif %}">
                    <a class="nav-link {% if link.active %}active{% endif %}" href="{{ link.url }}">
                      {{ link.title }}
                    </a>
                    {% if link.links.size > 0 and section.settings.enable_mega_menu %}
                      <div class="mega-menu-container">
                          <div class="col-12 mega-menu">
                              <div class="container">
                                  {% for child_link in link.links %}
                                    <div class="col-md-3">
                                      <h3>
                                          <a href="{{ child_link.url }}">{{ child_link.title }}</a>
                                      </h3>
                                      {% if child_link.links.size > 0 %}
                                          <ul class="mega-submenu">
                                              {% for grandchild_link in child_link.links %}
                                                  <li><a href="{{ grandchild_link.url }}">{{ grandchild_link.title }}</a></li>
                                              {% endfor %}
                                          </ul>
                                      {% endif %}
                                  </div>
                                  {% endfor %}
                              </div>
                          </div>
                      </div>
                  {% endif %}
                  </li>
                {% endfor %}
              </ul>
            {% endif %}
          </nav>
          <nav class="col-menu col-align-left menu-items first-menu d-lg-none">
            <button class="hamburger-menu">
              {{- 'icon-hamburger.svg' | inline_asset_content -}}
            </button>
            <button class="close-menu">
              {{- 'icon-close.svg' | inline_asset_content -}}
            </button>
          </nav>
        </div>        
  
        <!-- Center: Logo -->
        <div class="col-menu text-center">
          <a href="{{ routes.root_url }}">
              <div class="logo"></div>
          </a>
        </div>
  
        <!-- Right: Search and Cart -->
        <div class="col-menu col-align-right text-second-menu">
          <div class="search-cart">
          <!-- Search -->
          {% render 'header-search', input_id: 'Search-In-Modal' %}
          <!-- Cart -->
          <div class="cart d-inline-block ml-3">
            <!-- On Desktop -->
            <div class="d-none d-lg-block hover-red">
              <a href="{{ routes.cart_url }}" class="cart-link">
                {{ 'cart' | t }}{% if cart.item_count > 0 %} ({{ cart.item_count }}){% endif %}
              </a>
            </div>
            <!-- On Mobile -->
            <div class="d-lg-none">
              <a href="/cart" class="cart-link">
                    {% if cart.item_count == 0 %}
                      {{ 'icon-cart-empty.svg' | inline_asset_content }}
                    {% else %}
                      {{ 'icon-cart.svg' | inline_asset_content }}
                    {% endif %}
                    <p class="cart-bubble">{% if cart.item_count > 0 %} {{ cart.item_count }}{% endif %}</p>
              </a>
            </div>            
          </div>
        </div>
        </div>
      </div> 
      <!-- Mobile Menu -->
      {% if section.settings.menu != blank %}
        {% assign menu = linklists[section.settings.menu] %}
        <div class="mobile-menu-overlay">
          <div class="mobile-menu-header">
            <button class="back-button" style="display: none;">
              <svg class="menu-arrow" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M9 18l6-6-6-6"></path>
              </svg>
            </button>
            <span class="current-menu-title">Menu</span>
          </div>
          
          <div class="menu-container">
            <!-- Main Menu Panel -->
            <div class="menu-panel active" data-level="0">
              <ul class="mobile-menu">
                {% for link in menu.links %}
                  <li class="nav-item {% if link.links.size > 0 %}has-submenu{% endif %}">
                    {% if link.links.size > 0 %}
                      <div class="menu-item-wrapper">
                        <a class="nav-link {% if link.active %}active{% endif %}" href="{{ link.url }}">
                          {{ link.title }}
                        </a>
                        <button class="submenu-toggle" data-target="{{ link.title | handle }}">
                          <svg class="menu-arrow" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M9 18l6-6-6-6"></path>
                          </svg>
                        </button>
                      </div>
                    {% else %}
                    <div class="menu-item-wrapper">
                      <a class="nav-link {% if link.active %}active{% endif %}" href="{{ link.url }}">
                        {{ link.title }}
                      </a>
                    </div>
                    {% endif %}
                  </li>
                {% endfor %}
              </ul>
            </div>

            <!-- Submenus -->
            {% for link in menu.links %}
              {% if link.links.size > 0 %}
                <div class="menu-panel" data-level="1" data-menu="{{ link.title | handle }}">
                  <ul class="mobile-menu">
                    {% for child_link in link.links %}
                      <li class="nav-item {% if child_link.links.size > 0 %}has-submenu{% endif %}">
                        {% if child_link.links.size > 0 %}
                          <div class="menu-item-wrapper">
                            <a class="nav-link" href="{{ child_link.url }}">{{ child_link.title }}</a>
                            <button class="submenu-toggle" data-target="{{ child_link.title | handle }}">
                              <svg class="menu-arrow" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M9 18l6-6-6-6"></path>
                              </svg>
                            </button>
                          </div>
                        {% else %}
                          <div class="menu-item-wrapper">
                          <a class="nav-link" href="{{ child_link.url }}">{{ child_link.title }}</a>
                          </div>
                        {% endif %}
                      </li>

                      {% if child_link.links.size > 0 %}
                        <div class="menu-panel" data-level="2" data-menu="{{ child_link.title | handle }}">
                          <ul class="mobile-menu">
                            {% for grandchild_link in child_link.links %}
                              <li class="nav-item">
                                <a class="nav-link" href="{{ grandchild_link.url }}">{{ grandchild_link.title }}</a>
                              </li>
                            {% endfor %}
                          </ul>
                        </div>
                      {% endif %}
                    {% endfor %}
                  </ul>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      {% endif %}
  </header>
</sticky-header>

<script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    {% if settings.logo %}
      "logo": {{ settings.logo | image_url: width: 500 | prepend: "https:" | json }},
    {% endif %}
    "sameAs": [
      {{ settings.social_twitter_link | json }},
      {{ settings.social_facebook_link | json }},
      {{ settings.social_pinterest_link | json }},
      {{ settings.social_instagram_link | json }},
      {{ settings.social_tiktok_link | json }},
      {{ settings.social_tumblr_link | json }},
      {{ settings.social_snapchat_link | json }},
      {{ settings.social_youtube_link | json }},
      {{ settings.social_vimeo_link | json }}
    ],
    "url": {{ request.origin | append: page.url | json }}
  }
</script>

{%- if request.page_type == 'index' -%}
  {% assign potential_action_target = request.origin | append: routes.search_url | append: "?q={search_term_string}" %}
  <script type="application/ld+json">
    {
      "@context": "http://schema.org",
      "@type": "WebSite",
      "name": {{ shop.name | json }},
      "potentialAction": {
        "@type": "SearchAction",
        "target": {{ potential_action_target | json }},
        "query-input": "required name=search_term_string"
      },
      "url": {{ request.origin | append: page.url | json }}
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Header",
  "class": "section-header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo_light",
      "label": "Light Mode Logo",
      "info": "Upload the logo for light mode."
    },
    {
      "type": "image_picker",
      "id": "logo_dark",
      "label": "Dark Mode Logo",
      "info": "Upload the logo for dark mode."
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Select Menu",
      "info": "Choose a menu to display in the header."
    },
    {
      "type": "checkbox",
      "id": "enable_mega_menu",
      "label": "Enable Mega Menu",
      "default": false,
      "info": "Enable mega menu for menu items with submenus"
    },
    {
      "type": "checkbox",
      "id": "sticky",
      "label": "Enable Sticky Header"
    },
    {
      "type": "checkbox",
      "id": "transparent",
      "label": "Enable Transparent Header",
      "info": "Make the header background transparent."
    },
    {
      "type": "checkbox",
      "id": "announcement_bar",
      "label": "Enable Announcement Bar",
      "default": false,
      "info": "Enable the announcement bar in the header."
    },
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Announcement Bar Text",
      "info": "Enter the text for the announcement bar."
    },
    {
      "type": "url",
      "id": "announcement_link",
      "label": "Announcement Bar Link",
      "info": "Enter a link for the announcement bar."
    }
  ]
}
{% endschema %}