{{ 'two-grid-lookbook.css' | asset_url | stylesheet_tag }}

<section>
  <div class="container-fluid section-padding">
    <div class="row">
      <!-- Column 1 -->
      <div class="col-md-6">
        {% for block in section.blocks %}
          {% if block.settings.column == 'column_1' %}
            <div class="lookbook-column">
              {% if block.settings.image != blank %}
                <div class="lookbook-background" 
                     style="background-image: url({{ block.settings.image | image_url }}); background-size: cover; background-position: center;">
                  <div class="dot" 
                       style="position: absolute; top: {{ block.settings.dot_top }}; bottom: {{ block.settings.dot_bottom }}; left: {{ block.settings.dot_left }}; right: {{ block.settings.dot_right }};">
                  </div>
                </div>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
      
      <!-- Column 2 -->
      <div class="col-md-6">
        {% for block in section.blocks %}
          {% if block.settings.column == 'column_2' %}
            <div class="lookbook-column">
              {% if block.settings.image != blank %}
                <div class="lookbook-background" 
                     style="background-image: url({{ block.settings.image | image_url }}); background-size: cover; background-position: center;">
                  <div class="dot" 
                       style="position: absolute; top: {{ block.settings.dot_top }}; bottom: {{ block.settings.dot_bottom }}; left: {{ block.settings.dot_left }}; right: {{ block.settings.dot_right }};">
                  </div>
                </div>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Two Column Lookbook",
  "settings": [],
  "blocks": [
    {
      "type": "lookbook_block",
      "name": "Lookbook Block",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Lookbook Image"
        },
        {
          "type": "select",
          "id": "column",
          "label": "Column",
          "options": [
            {
              "value": "column_1",
              "label": "Column 1"
            },
            {
              "value": "column_2",
              "label": "Column 2"
            }
          ],
          "default": "column_1"
        },
        {
          "type": "text",
          "id": "dot_top",
          "label": "Dot Top Position",
          "default": "10px"
        },
        {
          "type": "text",
          "id": "dot_bottom",
          "label": "Dot Bottom Position",
          "default": ""
        },
        {
          "type": "text",
          "id": "dot_left",
          "label": "Dot Left Position",
          "default": "50%"
        },
        {
          "type": "text",
          "id": "dot_right",
          "label": "Dot Right Position",
          "default": ""
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Two Column Lookbook"
    }
  ]
}
{% endschema %}
