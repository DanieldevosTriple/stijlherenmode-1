{{ 'two-grid-lookbook.css' | asset_url | stylesheet_tag }}

{% schema %}
{
  "name": "2 Column Collections Grid",
  "settings": [
    {
      "type": "image_picker",
      "label": "Left Column Image",
      "id": "left_column_image"
    },
    {
      "type": "image_picker",
      "label": "Right Column Image",
      "id": "right_column_image"
    },
    {
      "type": "text",
      "label": "Left Column Header",
      "id": "left_column_header",
      "default": "Left Column Header"
    },
    {
      "type": "textarea",
      "label": "Left Column Subheader",
      "id": "left_column_subhead",
      "default": "Left Column Subheader"
    },
    {
      "type": "collection",
      "label": "Left Column Collection",
      "id": "left_column_collection"
    },
    {
      "type": "text",
      "label": "Right Column Header",
      "id": "right_column_header",
      "default": "Right Column Header"
    },
    {
      "type": "textarea",
      "label": "Right Column Subheader",
      "id": "right_column_subhead",
      "default": "Right Column Subheader"
    },
    {
      "type": "collection",
      "label": "Right Column Collection",
      "id": "right_column_collection"
    }
  ],
  "presets": [
    {
      "name": "2 Column Collections",
      "settings": {
        "left_column_header": "Explore Our Collection",
        "left_column_subhead": "Find the perfect pieces to complete your look.",
        "right_column_header": "Special Offers",
        "right_column_subhead": "Exclusive discounts on select items."
      }
    }
  ]
}
{% endschema %}

<div class="col-12 two-column-section">
  <div class="column left-column" style="background-image: url('{{ section.settings.left_column_image | image_url }}');">
    <div class="content">
      <h5 class="card-title">{{ section.settings.left_column_header }}</h5>
      <p>{{ section.settings.left_column_subhead }}</p>
    </div>
    {% if section.settings.left_column_collection %}
      <div class="product-block">
        {% assign product_count = 0 %}
        {% for product in section.settings.left_column_collection.products limit: 3 %}
          {% if product_count < 3 %}
            <div class="product-item">
              <a href="{{ product.url }}" class="product-link">
                <img src="{{ product.featured_image | image_url }}" height="" width="" alt="{{ product.title }}">
                <div class="product-info">
                  <p>{{ product.title }}</p>
                  <p class="product-price">{{ product.price | money }}</p> <!-- Hier wordt de prijs onder de naam toegevoegd -->
                </div>
              </a>
            </div>
            {% assign product_count = product_count | plus: 1 %}
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
  </div>
  
  <div class="column right-column" style="background-image: url('{{ section.settings.right_column_image | image_url }}');">
    <div class="content">
      <h5 class="card-title">{{ section.settings.right_column_header }}</h5>
      <p>{{ section.settings.right_column_subhead }}</p>
    </div>
    {% if section.settings.right_column_collection %}
      <div class="product-block">
        {% assign product_count = 0 %}
        {% for product in section.settings.right_column_collection.products limit: 3 %}
          {% if product_count < 3 %}
            <div class="product-item">
              <a href="{{ product.url }}" class="product-link">
                <img src="{{ product.featured_image | image_url }}" height="" width="" alt="{{ product.title }}">
                <div class="product-info">
                  <p>{{ product.title }}</p>
                  <p class="product-price">{{ product.price | money }}</p> <!-- Hier wordt de prijs onder de naam toegevoegd -->
                </div>
              </a>
            </div>
            {% assign product_count = product_count | plus: 1 %}
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>
