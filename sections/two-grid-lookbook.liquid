{{ 'two-grid-lookbook.css' | asset_url | stylesheet_tag }}

<section>
  <div class="container-fluid section-padding">
    <div class="row">
      <!-- Column 1 -->
      <div class="col-md-6">
        <div class="lookbook-column">
          {% if section.settings.image_1 != blank %}
            <div class="lookbook-background" 
                 style="background-image: url({{ section.settings.image_1 | image_url }}); background-size: cover; background-position: center;">
              <!-- Product 1 -->
              <div class="dot" 
                   style="position: absolute; top: {{ section.settings.dot_1_top }}; left: {{ section.settings.dot_1_left }};">
              </div>
              <!-- Product 2 -->
              <div class="dot" 
                   style="position: absolute; top: {{ section.settings.dot_2_top }}; left: {{ section.settings.dot_2_left }};">
              </div>
              <!-- Product 3 -->
              <div class="dot" 
                   style="position: absolute; top: {{ section.settings.dot_3_top }}; left: {{ section.settings.dot_3_left }};">
              </div>
            </div>
          {% endif %}
        </div>
      </div>
      
      <!-- Column 2 -->
      <div class="col-md-6">
        <div class="lookbook-column">
          {% if section.settings.image_2 != blank %}
            <div class="lookbook-background" 
                 style="background-image: url({{ section.settings.image_2 | image_url }}); background-size: cover; background-position: center;">
              <!-- Product 1 -->
              <div class="dot" 
                   style="position: absolute; top: {{ section.settings.dot_4_top }}; left: {{ section.settings.dot_4_left }};">
              </div>
              <!-- Product 2 -->
              <div class="dot" 
                   style="position: absolute; top: {{ section.settings.dot_5_top }}; left: {{ section.settings.dot_5_left }};">
              </div>
              <!-- Product 3 -->
              <div class="dot" 
                   style="position: absolute; top: {{ section.settings.dot_6_top }}; left: {{ section.settings.dot_6_left }};">
              </div>
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Two Column Lookbook",
  "settings": [
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Column 1 Lookbook Image"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Column 2 Lookbook Image"
    },
    {
      "type": "text",
      "id": "dot_1_top",
      "label": "Product 1 Dot Top Position (Column 1)",
      "default": "10%"
    },
    {
      "type": "text",
      "id": "dot_1_left",
      "label": "Product 1 Dot Left Position (Column 1)",
      "default": "50%"
    },
    {
      "type": "text",
      "id": "dot_2_top",
      "label": "Product 2 Dot Top Position (Column 1)",
      "default": "30%"
    },
    {
      "type": "text",
      "id": "dot_2_left",
      "label": "Product 2 Dot Left Position (Column 1)",
      "default": "50%"
    },
    {
      "type": "text",
      "id": "dot_3_top",
      "label": "Product 3 Dot Top Position (Column 1)",
      "default": "50%"
    },
    {
      "type": "text",
      "id": "dot_3_left",
      "label": "Product 3 Dot Left Position (Column 1)",
      "default": "50%"
    },
    {
      "type": "text",
      "id": "dot_4_top",
      "label": "Product 1 Dot Top Position (Column 2)",
      "default": "10%"
    },
    {
      "type": "text",
      "id": "dot_4_left",
      "label": "Product 1 Dot Left Position (Column 2)",
      "default": "50%"
    },
    {
      "type": "text",
      "id": "dot_5_top",
      "label": "Product 2 Dot Top Position (Column 2)",
      "default": "30%"
    },
    {
      "type": "text",
      "id": "dot_5_left",
      "label": "Product 2 Dot Left Position (Column 2)",
      "default": "50%"
    },
    {
      "type": "text",
      "id": "dot_6_top",
      "label": "Product 3 Dot Top Position (Column 2)",
      "default": "50%"
    },
    {
      "type": "text",
      "id": "dot_6_left",
      "label": "Product 3 Dot Left Position (Column 2)",
      "default": "50%"
    }
  ],
  "presets": [
    {
      "name": "Two Column Lookbook"
    }
  ]
}
{% endschema %}
