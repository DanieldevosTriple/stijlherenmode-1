{% comment %}theme-check-disable ImgLazyLoading{% endcomment %}
{{ 'component-product-hero.css' | asset_url | stylesheet_tag }}

<div class="product-hero color-{{ section.settings.color_scheme }} gradient">
  {%- comment -%} Mobile layout {%- endcomment -%}
  <div class="col-12 mobile-header">
    <div class="mobile-breadcrumb">
      {% if product.handle %}
        <nav aria-label="Mobile breadcrumb">
          <ol class="breadcrumbs__list">
            <li class="breadcrumbs__item">
              <a href="javascript:history.back()" class="breadcrumbs__link">
                <svg width="24" height="24" viewBox="0 0 24 24">
                  <path d="M15 18l-6-6 6-6" stroke="currentColor" fill="none" stroke-width="2" stroke-linecap="round"/>
                </svg>
              </a>
            </li>
            <li class="breadcrumbs__item">
              {% if product.collections.first %}
                <a href="{{ product.collections.first.url }}" class="breadcrumbs__link">{{ product.collections.first.title }}</a>
              {% else %}
                <a href="{{ routes.root_url }}" class="breadcrumbs__link">Home</a>
              {% endif %}
            </li>
          </ol>
        </nav>
      {% endif %}
    </div>
  </div>

  {%- comment -%} Desktop layout {%- endcomment -%}
  <div class="product-hero__inner scroll-trigger animate--fade-in">
    <div class="breadcrumbs">
        <nav class="breadcrumb overflow-hidden text-ellipsis">
            <a href="{{ routes.root_url }}">Home</a>
            {% if collection %}
              <span> / </span>
              <a href="{{ collection.url }}" class="breadcrumb-link">{{ collection.title }}</a>
            {% endif %}
            {% if product %}
              {% assign product_collection = collection %}
              {% if product_collection == blank %}
                {% assign product_collection = product.collections.first %}
              {% endif %}
              {% if product_collection %}
                <span> / </span>
                <a href="{{ product_collection.url }}" class="breadcrumb-link">{{ product_collection.title }}</a>
              {% endif %}
              <span> / </span>
              <span>{{ product.title }}</span>
            {% elsif article %}
              <span> / </span>
              <a href="{{ blog.url }}" class="breadcrumb-link">{{ blog.title }}</a>
              <span> / </span>
              <span>{{ article.title }}</span>
            {% elsif search %}
              <span> / </span>
              <span>Zoekresultaten voor "{{ search.terms }}"</span>
            {% endif %}
          </nav>   
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Main Product Banner",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Product Banner",
      "category": "Product"
    }
  ],
  "templates": ["product"]
}
{% endschema %}