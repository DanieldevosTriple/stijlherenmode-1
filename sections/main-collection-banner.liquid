{% comment %}theme-check-disable ImgLazyLoading{% endcomment %}
{{ 'component-collection-hero.css' | asset_url | stylesheet_tag }}

<div class="collection-hero color-{{ section.settings.color_scheme }} gradient">
  {%- comment -%} Mobile layout {%- endcomment -%}
  <div class="col-12 mobile-header">
    <div class="mobile-breadcrumb">
      {% if collection.handle %}
        <nav aria-label="Mobile breadcrumb">
          <ol class="breadcrumbs__list">
            <li class="breadcrumbs__item">
              <a href="javascript:history.back()" class="breadcrumbs__link">
                <svg width="24" height="24" viewBox="0 0 24 24">
                  <path d="M15 18l-6-6 6-6" stroke="currentColor" fill="none" stroke-width="2" stroke-linecap="round"/>
                </svg>
              </a>
            </li>
            <li class="breadcrumbs__item">
              <a href="{{ routes.root_url }}" class="breadcrumbs__link">Home</a>
            </li>
          </ol>
        </nav>
      {% endif %}
    </div>
    <div class="mobile-facets__filter">
      <button type="button" class="mobile-facets__open-button">
        {{ 'products.facets.filter_button' | t }}
      </button>
    </div>
  </div>

  {%- comment -%} Desktop layout {%- endcomment -%}
  <div class="collection-hero__inner scroll-trigger animate--fade-in">
    <div class="breadcrumbs">
      <nav aria-label="Breadcrumbs">
        <ol class="breadcrumbs__list">
          {% if collection.handle %}
            <li class="breadcrumbs__item">
              <a href="javascript:history.back()" class="breadcrumbs__link">
                <svg width="24" height="24" viewBox="0 0 24 24">
                  <path d="M15 18l-6-6 6-6" stroke="currentColor" fill="none" stroke-width="2" stroke-linecap="round"/>
                </svg>
              </a>
            </li>
            <li class="breadcrumbs__item">
              <a href="{{ routes.root_url }}" class="breadcrumbs__link">Home</a>
            </li>
            <li class="breadcrumbs__item">
              <span>{{ collection.title }}</span>
            </li>
          {% endif %}
        </ol>
      </nav>
    </div>
    
    <div class="collection-title">
      <h1>
        <span class="visually-hidden">{{ 'sections.collection_template.title' | t }}: </span>
        {{- collection.title | escape -}}
      </h1>
    </div>
    
    <div class="product-count">
      {% if collection.all_products_count > 0 %}
        <span>{{ collection.all_products_count }} {% if collection.all_products_count == 1 %}product{% else %}producten{% endif %}</span>
      {% endif %}
    </div>
  </div>

  {% unless collection.handle %}
    <div class="collection-title">
      <h1>
        <span class="visually-hidden">{{ 'sections.collection_template.title' | t }}: </span>
        {{- collection.title | escape -}}
      </h1>
    </div>
  {% endunless %}
</div>

{% schema %}
{
  "name": "t:sections.main-collection-banner.name",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.main-collection-banner.settings.paragraph.content"
    },
    {
      "type": "checkbox",
      "id": "show_collection_description",
      "default": true,
      "label": "t:sections.main-collection-banner.settings.show_collection_description.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}