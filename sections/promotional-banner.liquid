{% comment %}
  sections/promotional-banner.liquid
{% endcomment %}

{%- if section.settings.show_banner -%}
    <div class="promotional-banner {% if section.settings.enable_sticky %}banner-sticky{% endif %}" 
         style="background-color: {{ section.settings.background_color }}">
      <div class="page-width">
        <div class="banner__content">
          {%- if section.settings.link != blank -%}
            <a href="{{ section.settings.link }}" class="banner__link">
          {%- endif -%}
  
          <div class="banner__text" style="color: {{ section.settings.text_color }}">  
            {%- if section.settings.text != blank -%}
              <span class="banner__text-content">{{ section.settings.text | escape }}</span>
            {%- endif -%}
          </div>
          {%- if section.settings.show_close_button -%}
            <button type="button" class="banner__close" aria-label="{{ 'general.accessibility.close' | t }}">
                {{- 'icon-close.svg' | inline_asset_content -}}
            </button>
          {%- endif -%}
        </div>
      </div>
    </div>
  
    {% style %}
      .promotional-banner {
        transition: opacity 0.3s ease-in-out;
        opacity: 1;
      }
  
      .promotional-banner.banner-sticky {
        position: sticky;
        top: 0;
        z-index: 100;
      }
  
      .promotional-banner.is-hidden {
        opacity: 0;
        display: none;
      }
  
      .banner__content {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: {{ section.settings.padding_y }}px {{ section.settings.padding_x }}px;
        gap: 1rem;
        flex-wrap: wrap;
      }
  
      @media screen and (min-width: 750px) {
        .banner__content {
          flex-wrap: nowrap;
        }
      }
  
      .banner__link {
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 1rem;
        flex: 1;
      }
  
      .banner__text {
        display: flex;
        gap: 0.5rem;
        align-items: center;
        flex-wrap: wrap;
        justify-content: center;
        text-transform: uppercase;
      }
  
      .banner__close {
        padding: 0.5rem;
        background: transparent;
        border: none;
        cursor: pointer;
        color: currentColor;
      }
    {% endstyle %}
  
    <script>
      document.addEventListener('DOMContentLoaded', function() {
        const banner = document.querySelector('.promotional-banner');
        const closeButton = banner.querySelector('.banner__close');
        
        if (closeButton) {
          closeButton.addEventListener('click', function() {
            banner.classList.add('is-hidden');
            if ({{ section.settings.save_closed_state | json }}) {
              localStorage.setItem('promoBannerClosed', 'true');
            }
          });
        }
  
        // Check if banner was previously closed
        if ({{ section.settings.save_closed_state | json }}) {
          if (localStorage.getItem('promoBannerClosed') === 'true') {
            banner.classList.add('is-hidden');
          }
        }
      });
    </script>
  {%- endif -%}
  
  {% schema %}
  {
    "name": "Promotional Banner",
    "settings": [
      {
        "type": "header",
        "content": "Banner Visibility"
      },
      {
        "type": "checkbox",
        "id": "show_banner",
        "label": "Show banner",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "enable_sticky",
        "label": "Make banner sticky",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "show_close_button",
        "label": "Show close button",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "save_closed_state",
        "label": "Remember closed state",
        "default": true,
        "info": "If enabled, the banner will stay hidden for users who have closed it"
      },
      {
        "type": "header",
        "content": "Content"
      },
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "Special Offer!"
      },
      {
        "type": "text",
        "id": "text",
        "label": "Text",
        "default": "Use code SAVE20 for 20% off your order"
      }
    ],
    "presets": [
      {
        "name": "Promotional Banner",
        "category": "Promotional"
      }
    ]
  }
  {% endschema %}