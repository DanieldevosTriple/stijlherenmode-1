{{ 'featured-product-custom.css' | asset_url | stylesheet_tag }}

<section class="featured-product-custom col-12 section-padding">
  <ul class="featured-product-list">
    <li class="text-container-product">
      <div class="featured-product-text">
        <h2 class="featured-product__title">{{ section.settings.title }}</h2>
        <p class="featured-product__description">{{ section.settings.description }}</p>
        {% if section.settings.button_text != blank %}
          <a href="{{ section.settings.button_link }}" class="button-featured-product-custom">{{ section.settings.button_text }}</a>
        {% endif %}
      </div>
    </li>
    <li class="text-center image-container">
      <img 
        srcset="
          {{ section.settings.featured_image | image_url: width: 360 }} 360w,
          {{ section.settings.featured_image | image_url: width: 533 }} 533w,
          {{ section.settings.featured_image | image_url: width: 720 }} 720w,
          {{ section.settings.featured_image | image_url: width: 1080 }} 1080w,
          {{ section.settings.featured_image | image_url: width: 1500 }} 1500w"
        sizes="(max-width: 360px) 360px,
               (max-width: 720px) 533px,
               (max-width: 1080px) 720px,
               (max-width: 1500px) 1080px,
               1500px"
        src="{{ section.settings.featured_image | image_url: width: 533 }}"
        alt="{{ section.settings.featured_image_alt | escape }}"
        width="{{ section.settings.featured_image.width }}"
        height="{{ section.settings.featured_image.height }}"
        class="img-fluid featured-product__image"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      >
    </li>
  </ul>
</section>

{% schema %}
{
  "name": "Featured Product Custom",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Featured Product"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Add a description of your featured product here."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Learn More"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link",
      "default": "/"
    },
    {
      "type": "image_picker",
      "id": "featured_image",
      "label": "Featured Image"
    },
    {
      "type": "text",
      "id": "featured_image_alt",
      "label": "Featured Image Alt Text",
      "default": "Featured Product Image"
    }
  ],
 "presets": [
    {
      "name": "Custom Featured Product"
    }
  ]
}
{% endschema %}