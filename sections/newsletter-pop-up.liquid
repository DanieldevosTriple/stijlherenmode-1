{% comment %}theme-check-disable UndefinedObject{% endcomment %}
{{ 'newsletter-popup.css' | asset_url | stylesheet_tag }}

<div 
  class="popup-overlay js-newsletter-popup" 
  data-popup-overlay
  data-show-on="{{ section.settings.show_on }}"
  data-delay="{{ section.settings.delay }}"
  data-show-once="{{ section.settings.show_once }}"
  data-cookie-name="{{ section.settings.cookie_name }}"
  data-cookie-duration="{{ section.settings.cookie_duration }}"
  data-confirmation-duration="{{ section.settings.confirmation_duration }}"
>
  <div class="popup-container">
    <button class="popup-close" data-popup-close>
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M6 6L18 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
    
    <div class="popup-content">
      <div class="popup-main" data-popup-main>
        <h2 class="newsletter-header">{{ section.settings.header }}</h2>
        <p class="newsletter-subheader">{{ section.settings.subheader }}</p>
    
        {% if section.settings.disclaimer != blank %}
          <div class="popup-policy"><p>{{ section.settings.disclaimer | escape }}</p></div>
        {% endif %}
    
        {% form 'contact', id: 'PopUp', class: 'newsletter-form' %}
          <div class="newsletter-pop-up-field" data-popup-form>
            <input type="hidden" name="form_type" value="customer" />
            <input type="hidden" name="utf8" value="✓" />
            <input type="hidden" name="contact[tags]" value="newsletter" id="contact_tags" />
            
            <!-- Email field -->
            <input type="email"
              class="newsletter-pop-up-field-input" 
              name="contact[email]"
              id="Email"
              required
              value="{% if customer.email != blank %}{{ customer.email }}{% endif %}"
              placeholder="{{ 'newsletter.label' | t }}"
              autocorrect="off"
              autocapitalize="off">
              
            <!-- Interest section -->
            <p class="newsletter-interest">Ik ben geinteresseerd in:</p>
            <div class="interests">
              <label>
                <input type="checkbox" name="interest_tags" value="Stijl Casual" /> Stijl Casual
              </label>
              <label>
                <input type="checkbox" name="interest_tags" value="Stijl Herenmode" /> Stijl Herenmode
              </label>
            </div>
            
            <!-- Submit button -->
            <button type="submit" class="newsletter-button" name="commit" id="Subscribe">
              <span>{{ section.settings.button_text }}</span>
            </button>
          </div>
        {% endform %}
        
        <!-- Success Message -->
        <div class="popup-success hidden" data-popup-success>
          <h2>{{ section.settings.confirmation_title }}</h2>
          <div>{{ section.settings.confirmation_message }}</div>
        </div>     
      </div>      
    </div>
  </div>
</div>

<script>
  document.querySelector('.newsletter-form').addEventListener('submit', function(e) {
    e.preventDefault();  // Prevent the form from submitting immediately

    // Collect the selected checkboxes
    const selectedTags = [];
    document.querySelectorAll('input[name="interest_tags"]:checked').forEach(function(checkbox) {
      selectedTags.push(checkbox.value);
    });

    // If there are selected tags, append them to the contact[tags] hidden field
    if (selectedTags.length > 0) {
      const tagsField = document.getElementById('contact_tags');
      tagsField.value = 'newsletter,' + selectedTags.join(',');
    }

    // Now submit the form after modifying the contact[tags] field
    this.submit();
  });
</script>

<script>
  class NewsletterPopup {
    constructor() {
      console.log('Initializing NewsletterPopup...');
      this.overlay = document.querySelector('.js-newsletter-popup');
      console.log('Overlay found:', this.overlay);
      if (!this.overlay) {
        console.log('Overlay not found!');
        return;
      }
  
      this.closeBtn = this.overlay.querySelector('[data-popup-close]');
      console.log('Close Button:', this.closeBtn);
      this.form = this.overlay.querySelector('form');
      console.log('Form:', this.form);
  
      this.mainContent = this.overlay.querySelector('[data-popup-main]');
      console.log('Main Content:', this.mainContent);
      this.successContent = this.overlay.querySelector('[data-popup-success]');
      console.log('Success Content:', this.successContent);
  
      this.settings = {
        showOn: this.overlay.dataset.showOn,
        delay: parseInt(this.overlay.dataset.delay, 10) * 1000,
        showOnce: this.overlay.dataset.showOnce === 'true',
        cookieName: this.overlay.dataset.cookieName || 'newsletter_popup',
        cookieDuration: parseInt(this.overlay.dataset.cookieDuration, 10) || 30,
        confirmationDuration: parseInt(this.overlay.dataset.confirmationDuration, 10) * 1000
      };
      console.log('Settings initialized:', this.settings);
  
      this.init();
    }
  
    show() {
      this.scrollPos = window.scrollY;
      this.overlay.classList.add('active');
      document.body.style.overflow = 'hidden';
      this.overlay.style.top = '0';
      this.overlay.style.position = 'fixed';
    }
  
    showSuccess() {
      if (this.mainContent && this.successContent) {
        this.mainContent.classList.add('hidden');
        this.successContent.classList.remove('hidden');
      }
    }
  
    hide() {
      this.overlay.classList.remove('active');
      document.body.style.overflow = '';
      window.scrollTo(0, this.scrollPos);
    }
  
    init() {
      if (!this.overlay || !this.closeBtn || !this.form) {
        console.log('One or more required elements are missing!');
        return;
      }
  
      // Check if the URL contains `customer_posted=true` and `#contact_form_pop_up`
      if (window.location.search.indexOf('customer_posted=true') !== -1 && window.location.hash === '#contact_form_pop_up') {
        console.log('Customer has posted, showing success immediately.');
        this.showSuccess();
      } else {
        // Otherwise, wait for the normal delay
        setTimeout(() => {
          console.log('Displaying popup...');
          this.show();
        }, this.settings.delay);
      }
  
      // Event listeners
      this.closeBtn.addEventListener('click', () => {
        console.log('Closing popup...');
        this.hide();
        this.setCookie();  // Set cookie when popup is closed
      });
  
      this.overlay.addEventListener('click', (e) => {
        if (e.target === this.overlay) {
          console.log('Clicked outside popup, closing...');
          this.hide();
          this.setCookie();  // Set cookie when clicking outside the popup
        }
      });
  
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          console.log('Escape key pressed, closing popup...');
          this.hide();
          this.setCookie();  // Set cookie when escape key is pressed
        }
      });
  
      this.form.addEventListener('submit', (e) => this.handleSubmit(e));
    }
  
    handleSubmit(e) {
      e.preventDefault();  // Prevent form from submitting immediately
      
      const formData = new FormData(this.form);
      formData.append('form_type', 'customer');
      formData.append('utf8', '✓');
  
      fetch('/contact', {
        method: 'POST',
        body: formData,
        headers: {
          'Accept': 'application/json',
          'X-Requested-With': 'XMLHttpRequest'
        }
      })
      .then(response => {
        if (response.ok) {
          this.showSuccess();
          window.location.search = "?customer_posted=true#contact_form_pop_up";
        } else {
          throw new Error('Network response was not ok');
        }
      })
      .catch(error => {
        console.error('Newsletter subscription failed:', error);
      });
    }
  
    setCookie() {
      try {
        const date = new Date();
        date.setTime(date.getTime() + (this.settings.cookieDuration * 24 * 60 * 60 * 1000));
        const cookieString = `${this.settings.cookieName}=true; expires=${date.toUTCString()}; path=/`;
        document.cookie = cookieString;
        console.log('Cookie set successfully:', cookieString);
      } catch (error) {
        console.error('Error setting cookie:', error);
      }
    }
  
    getCookie(name) {
      const match = document.cookie.match(new RegExp('(^| )' + name + '=([^;]+)'));
      return match ? match[2] : null;
    }
  }
  
  // Initialize popup
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => new NewsletterPopup());
  } else {
    new NewsletterPopup();
  }  
</script>

{% schema %}
{
  "name": "Newsletter Popup",
  "settings": [
    {
      "type": "header",
      "content": "Content Settings"
    },
    {
      "type": "text",
      "id": "header",
      "label": "Popup Header",
      "default": "Abonneer op onze nieuwsbrief"
    },
    {
      "type": "text",
      "id": "subheader",
      "label": "Popup Subheader",
      "default": "Meld je aan en blijf op de hoogte van de laatste aanbiedingen en nieuws."
    },
    {
      "type": "text",
      "id": "disclaimer",
      "label": "Disclaimer Text",
      "default": "Voorwaarden zijn van toepassing. Deze actie geldt alleen voor nieuwe abonnees."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Submit Button Text",
      "default": "Abonneer"
    },
    {
      "type": "header",
      "content": "Bevestiging"
    },
    {
      "type": "text",
      "id": "confirmation_title",
      "label": "Confirmation Title",
      "default": "Bedankt voor je inschrijving"
    },
    {
      "type": "richtext",
      "id": "confirmation_message",
      "label": "Confirmation Message",
      "default": "<p>Je bent succesvol ingeschreven voor de nieuwsbrief</p>"
    },
    {
      "type": "number",
      "id": "confirmation_duration",
      "label": "Confirmation Display Duration (seconds)",
      "default": 3
    },
    {
      "type": "header",
      "content": "Display Settings"
    },
    {
      "type": "select",
      "id": "show_on",
      "label": "Show Popup On",
      "options": [
        {
          "value": "homepage",
          "label": "Homepage Only"
        },
        {
          "value": "all_pages",
          "label": "All Pages"
        }
      ],
      "default": "homepage"
    },
    {
      "type": "number",
      "id": "delay",
      "label": "Delay (seconds)",
      "default": 5
    },
    {
      "type": "checkbox",
      "id": "show_once",
      "label": "Show Only Once",
      "default": true
    },
    {
      "type": "text",
      "id": "cookie_name",
      "label": "Cookie Name",
      "default": "newsletter_popup"
    },
    {
      "type": "number",
      "id": "cookie_duration",
      "label": "Cookie Duration (days)",
      "default": 30
    },
    {
      "type": "text",
      "id": "select_option",
      "label": "Default Select Option",
      "default": "Stijl Casual"
    }
  ],
  "presets": [
    {
      "name": "Newsletter Popup"
    }
  ]
}
{% endschema %}