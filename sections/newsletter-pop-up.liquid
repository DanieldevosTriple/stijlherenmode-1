{% comment %}
sections/newsletter-popup.liquid
{% endcomment %}

{%- style -%}
.popup-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgb(255, 255, 255, 0.8);
  backdrop-filter: blur(0.8rem);
  z-index: 1000;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.3s, visibility 0.3s;
}

.popup-overlay.active {
  opacity: 1;
  visibility: visible;
}

.popup-container {
  position: fixed;
  top: 50vh;
  left: 50%;
  transform: translate(-50%, -50%);
  margin: 0;
  background: #ffffff;
  padding: 2rem;
  width: 100%;
  max-width: 500px;
  aspect-ratio: 1/1;
  z-index: 1001;
  border: 0.1rem solid #b5b5b5;
}

.popup-close {
  position: absolute;
  top: 1rem;
  right: 1rem;
  cursor: pointer;
  background: none;
  border: none;
  padding: 0.5rem;
  color: black;
  width: 25px;
  height: 25px;
}

.popup-content {
  text-align: center;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 1.5rem;
}

.popup-form {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.popup-input {
  padding: 0.75rem;
  border: 1px solid #ddd;
  border-radius: 4px;
}

.popup-submit {
  padding: 0.75rem;
  background: #000;
  color: #fff;
  border: none;
  border-radius: 4px;
  cursor: pointer;
  transition: opacity 0.2s;
}

.popup-submit:hover {
  opacity: 0.9;
}

.popup-policy {
  font-size: 0.875rem;
  color: #666;
}

.popup-success {
  display: none;
}

.popup-main.hidden,
.popup-success.hidden {
  display: none;
}
{%- endstyle -%}

<div 
  class="popup-overlay js-newsletter-popup" 
  data-popup-overlay
  data-show-on="{{ section.settings.show_on }}"
  data-delay="{{ section.settings.delay }}"
  data-show-once="{{ section.settings.show_once }}"
  data-cookie-name="{{ section.settings.cookie_name }}"
  data-cookie-duration="{{ section.settings.cookie_duration }}"
  data-confirmation-duration="{{ section.settings.confirmation_duration }}"
>
  <div class="popup-container">
    <button class="popup-close" data-popup-close>
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M6 6L18 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
    
    <div class="popup-content">
      <div class="popup-main" data-popup-main>
        <h2>{{ section.settings.title }}</h2>
        <div>{{ section.settings.description }}</div>
        
        {% form 'customer' %}
          <div class="email">
            <label for="email">Email</label>
            <input type="email" name="contact[email]" />
          </div>
        
          <div class="submit">
            <input type="submit" value="Sign up" />
          </div>
        {% endform %}
      </div>
      
      <div class="popup-success hidden" data-popup-success>
        <h2>{{ section.settings.confirmation_title }}</h2>
        <div>{{ section.settings.confirmation_message }}</div>
      </div>
    </div>
  </div>
</div>

<script>
class NewsletterPopup {
  constructor() {
    this.overlay = document.querySelector('.js-newsletter-popup');
    if (!this.overlay) return;
    
    this.closeBtn = this.overlay.querySelector('[data-popup-close]');
    this.form = this.overlay.querySelector('[data-popup-form]');
    this.mainContent = this.overlay.querySelector('[data-popup-main]');
    this.successContent = this.overlay.querySelector('[data-popup-success]');
    
    this.settings = {
      showOn: this.overlay.dataset.showOn,
      delay: parseInt(this.overlay.dataset.delay, 10) * 1000,
      showOnce: this.overlay.dataset.showOnce === 'true',
      cookieName: this.overlay.dataset.cookieName,
      cookieDuration: parseInt(this.overlay.dataset.cookieDuration, 10),
      confirmationDuration: parseInt(this.overlay.dataset.confirmationDuration, 10) * 1000
    };
    
    this.init();
  }

  init() {
    if (!this.shouldShowPopup()) return;
    
    setTimeout(() => this.show(), this.settings.delay);
    
    this.closeBtn.addEventListener('click', () => this.hide());
    this.form.addEventListener('submit', (e) => this.handleSubmit(e));
    
    this.overlay.addEventListener('click', (e) => {
      if (e.target === this.overlay) this.hide();
    });
    
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') this.hide();
    });
  }

  shouldShowPopup() {
    const isHomepage = document.body.classList.contains('template-index');
    
    if (this.settings.showOn === 'homepage' && !isHomepage) {
      return false;
    }
    
    if (this.settings.showOnce && this.getCookie(this.settings.cookieName)) {
      return false;
    }
    
    return true;
  }

  show() {
    // Store current scroll position
    this.scrollPos = window.scrollY;
    this.overlay.classList.add('active');
    document.body.style.overflow = 'hidden';
    
    // Ensure popup appears relative to viewport
    this.overlay.style.top = '0';
    this.overlay.style.position = 'fixed';
  }

  hide() {
    this.overlay.classList.remove('active');
    document.body.style.overflow = '';
    
    // Restore scroll position
    window.scrollTo(0, this.scrollPos);
    
    if (this.settings.showOnce) {
      this.setCookie();
    }
  }

  handleSubmit(e) {
    e.preventDefault();
    const formData = new FormData(this.form);
    
    fetch(this.form.action, {
      method: 'POST',
      body: formData,
      headers: {
        'Accept': 'application/json'
      }
    })
    .then(response => response.json())
    .then(() => {
      this.showSuccess();
      this.setCookie();
      setTimeout(() => this.hide(), this.settings.confirmationDuration);
    })
    .catch(error => {
      console.error('Newsletter subscription failed:', error);
    });
  }

  showSuccess() {
    this.mainContent.classList.add('hidden');
    this.successContent.classList.remove('hidden');
  }

  setCookie() {
    const date = new Date();
    date.setTime(date.getTime() + (this.settings.cookieDuration * 24 * 60 * 60 * 1000));
    document.cookie = `${this.settings.cookieName}=true; expires=${date.toUTCString()}; path=/`;
  }

  getCookie(name) {
    const match = document.cookie.match(new RegExp('(^| )' + name + '=([^;]+)'));
    return match ? match[2] : null;
  }
}

// Initialize popup
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', () => new NewsletterPopup());
} else {
  new NewsletterPopup();
}
</script>

{% schema %}
{
  "name": "Newsletter Popup",
  "settings": [
    {
      "type": "header",
      "content": "Content Settings"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Popup Title",
      "default": "Join Our Newsletter"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Subscribe to get special offers, free giveaways, and once-in-a-lifetime deals.</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Submit Button Text",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "policy_text",
      "label": "Privacy Policy Text",
      "default": "By signing up, you agree to our Privacy Policy"
    },
    {
      "type": "header",
      "content": "Confirmation Screen"
    },
    {
      "type": "text",
      "id": "confirmation_title",
      "label": "Confirmation Title",
      "default": "Thank You!"
    },
    {
      "type": "richtext",
      "id": "confirmation_message",
      "label": "Confirmation Message",
      "default": "<p>You've successfully subscribed to our newsletter.</p>"
    },
    {
      "type": "number",
      "id": "confirmation_duration",
      "label": "Confirmation Display Duration (seconds)",
      "default": 3
    },
    {
      "type": "header",
      "content": "Display Settings"
    },
    {
      "type": "select",
      "id": "show_on",
      "label": "Show Popup On",
      "options": [
        {
          "value": "homepage",
          "label": "Homepage Only"
        },
        {
          "value": "all_pages",
          "label": "All Pages"
        }
      ],
      "default": "homepage"
    },
    {
      "type": "number",
      "id": "delay",
      "label": "Delay (seconds)",
      "default": 5
    },
    {
      "type": "checkbox",
      "id": "show_once",
      "label": "Show Only Once",
      "default": true
    },
    {
      "type": "text",
      "id": "cookie_name",
      "label": "Cookie Name",
      "default": "newsletter_popup"
    },
    {
      "type": "number",
      "id": "cookie_duration",
      "label": "Cookie Duration (days)",
      "default": 30
    }
  ],
  "presets": [
    {
      "name": "Newsletter Popup"
    }
  ]
}
{% endschema %}