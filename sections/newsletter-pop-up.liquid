{% comment %}
sections/newsletter-popup.liquid
{% endcomment %}

{%- style -%}
.hidden {
  display: none !important;
}

.h-captcha {
  margin: 1rem 0;
  display: flex;
  justify-content: center;
}

.popup-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgb(255, 255, 255, 0.8);
  backdrop-filter: blur(0.8rem);
  z-index: 1000;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.3s, visibility 0.3s;
}

.interests {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1rem;
  padding: 1rem 2rem 2rem 2rem;
  text-transform: uppercase;
  font-family: TradeGothicLT, sans-serif;
  font-size: 15px;  
}

.newsletter-interest {
  padding-top: 2rem;
  font-size: 11px;
}

.interests label {
  vertical-align: middle; /* Zorg ervoor dat ze verticaal gecentreerd zijn */
  display: inline-block;
  font-family: TradeGothicLT, sans-serif;
  text-transform: uppercase;
  font-size: 11px;
}

.newsletter-header {
  padding-bottom: 1rem;
}

.newsletter-subheader {
  padding-bottom: 1rem;
  text-transform: uppercase;
  font-family: TradeGothicLT, sans-serif;
  font-size: 12px;
}

.interests input[type="checkbox"] {
  position: relative;
    width: 2.4rem;
    height: 2.4rem;
    margin-right: .8rem;
    display: inline-flex;
    flex-shrink: 0;
    background-color: #f1f1f1;
    border-radius: 50%;
    -webkit-appearance: none;
    appearance: none;
    cursor: pointer;
    vertical-align: middle; /* Zorg ervoor dat de radio button en de tekst op dezelfde hoogte staan */
}

.interests input[type=checkbox]:checked {
    background-color: #efefef;
    border-color: #efefef;
}

.interests input[type=checkbox]:checked::after {
  content: '✔';
    color: black;
    font-size: 15px;
    position: absolute;
    top: 1px;
    left: 6px;
}

.newsletter-pop-up-field-input {
    padding: 10px;
    font-family: TradeGothicLT, sans-serif;
    font-size: 15px;
    text-transform: uppercase;
    font-weight: 600;
    text-align: left;
    background-color: #faf7f3;
    border: 2px solid black;
    color: #000;
    border-radius: 0;
    width: 100%;
}

.newsletter-button {
    background-color: #000;
    border: 2px solid black;
    color: #fff;
    padding: 10px 50px;
    text-align: center;
    text-decoration: none;
    display: inline-block;
    font-size: 15px;
    text-transform: uppercase;
    font-weight: 600;
    font-family: TradeGothicLT, sans-serif;
    cursor: pointer;
    width: 100%;
}

.newsletter-button:hover {
    background-color: #fff;
    color: #000;
    border: 2px solid black;
}

.popup-overlay.active {
  opacity: 1;
  visibility: visible;
}

.popup-container {
  position: fixed;
  top: 50vh;
  left: 50%;
  transform: translate(-50%, -50%);
  margin: 0;
  background: #ffffff;
  padding: 2rem;
  width: 100%;
  max-width: 500px;
  aspect-ratio: 1/1;
  z-index: 1001;
  border: 0.1rem solid #b5b5b5;
}

.popup-close {
  position: absolute;
  top: 1rem;
  right: 1rem;
  cursor: pointer;
  background: none;
  border: none;
  padding: 0.5rem;
  color: black;
  width: 25px;
  height: 25px;
}

.popup-content {
  text-align: center;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 1.5rem;
}

.popup-form {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.popup-input {
  padding: 0.75rem;
  border: 1px solid #ddd;
  border-radius: 4px;
}

.popup-submit {
  padding: 0.75rem;
  background: #000;
  color: #fff;
  border: none;
  border-radius: 4px;
  cursor: pointer;
  transition: opacity 0.2s;
}

.popup-submit:hover {
  opacity: 0.9;
}

.popup-policy {
  font-size: 0.875rem;
  color: lightgray;
}

.popup-success {
  display: none;
}

.popup-main.hidden,
.popup-success.hidden {
  display: none;
}
{%- endstyle -%}

<div 
  class="popup-overlay js-newsletter-popup" 
  data-popup-overlay
  data-show-on="{{ section.settings.show_on }}"
  data-delay="{{ section.settings.delay }}"
  data-show-once="{{ section.settings.show_once }}"
  data-cookie-name="{{ section.settings.cookie_name }}"
  data-cookie-duration="{{ section.settings.cookie_duration }}"
  data-confirmation-duration="{{ section.settings.confirmation_duration }}"
>
  <div class="popup-container">
    <button class="popup-close" data-popup-close>
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M6 6L18 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
    
    <div class="popup-content">
      <div class="popup-main" data-popup-main>
        <h2 class="newsletter-header">{{ section.settings.header }}</h2>
        <p class="newsletter-subheader">{{ section.settings.subheader }}</p>
    
        {% if section.settings.disclaimer != blank %}
          <div class="popup-policy"><p>{{ section.settings.disclaimer | escape }}</p></div>
        {% endif %}
    
        {% form 'contact', class: 'newsletter-form' %}
          <div class="newsletter-pop-up-field" data-popup-form>
            {{ form.errors | default_errors }}
            <input type="hidden" name="contact[tags]" value="newsletter,{{ section.settings.select_option }}">
            <input type="email"
              class="newsletter-pop-up-field-input" 
              name="contact[email]"
              id="Email"
              required
              value="{% if customer.email != blank %}{{ customer.email }}{% endif %}"
              placeholder="{{ 'newsletter.label' | t }}"
              autocorrect="off"
              autocapitalize="off">
            <p class="newsletter-interest">Ik ben geinteresseerd in:</p>
            <div class="interests">
              <label>
                <input type="checkbox" name="contact[tags][]" value="Stijl Casual" /> Stijl Casual
              </label>
              <label>
                <input type="checkbox" name="contact[tags][]" value="Stijl Herenmode" /> Stijl Herenmode
              </label>
            </div>                
            <!-- Add hCaptcha div with site key -->
            <div class="h-captcha" data-sitekey="{{ section.settings.hcaptcha_site_key }}"></div>
            <button type="submit" class="newsletter-button" name="commit" id="Subscribe">
              <span>{{ section.settings.button_text }}</span>
            </button>
          </div>
        {% endform %}
          <!-- Add this success message container -->
        <div class="popup-success hidden" data-popup-success>
          <h2 class="newsletter-header">{{ section.settings.confirmation_title }}</h2>
          <p class="newsletter-subheader">{{ section.settings.confirmation_message }}</p>
        </div>
      </div>
    </div>    
  </div>
</div>

<script>
  class NewsletterPopup {
    constructor() {
      console.log('Initializing NewsletterPopup...');  // Debugging: Initialisatie van de popup
      this.overlay = document.querySelector('.js-newsletter-popup');
      console.log('Overlay found:', this.overlay);  // Debugging: Controleer of de overlay wordt gevonden
      if (!this.overlay) {
        console.log('Overlay not found!');  // Debugging: Overlay element niet gevonden
        return;
      }
  
      this.closeBtn = this.overlay.querySelector('[data-popup-close]');
      console.log('Close Button:', this.closeBtn);  // Debugging: Controleer of de sluitknop wordt gevonden
      this.form = this.overlay.querySelector('[data-popup-form]');
      console.log('Form:', this.form);  // Debugging: Controleer of het formulier wordt gevonden
  
      this.mainContent = this.overlay.querySelector('[data-popup-main]');
      console.log('Main Content:', this.mainContent);  // Debugging: Controleer het hoofdcontent-element
      this.successContent = this.overlay.querySelector('[data-popup-success]');
      console.log('Success Content:', this.successContent);  // Debugging: Controleer of de succescontent wordt gevonden
  
      this.settings = {
        showOn: this.overlay.dataset.showOn,
        delay: parseInt(this.overlay.dataset.delay, 10) * 1000,
        showOnce: this.overlay.dataset.showOnce === 'true',
        cookieName: this.overlay.dataset.cookieName || 'newsletter_popup', // Add default
        cookieDuration: parseInt(this.overlay.dataset.cookieDuration, 10) || 30, // Add default
        confirmationDuration: parseInt(this.overlay.dataset.confirmationDuration, 10) * 1000
      };
      console.log('Settings initialized:', this.settings); // Debug settings

    this.init();  // Add this line
  }
  
    init() {
      console.log('Initializing events...');  // Debugging: Evenementen initialiseren
  
      // Controleer of de noodzakelijke elementen bestaan
      if (!this.overlay || !this.closeBtn || !this.form) {
        console.log('One or more required elements are missing!');  // Debugging: Als belangrijke elementen ontbreken
        return;
      }
  
      // Controleer of we de popup moeten tonen
      if (!this.shouldShowPopup()) {
        console.log('Popup should not be shown');  // Debugging: Popup wordt niet getoond
        return;
      }
  
      // Wacht tot de vertraging en toon de popup
      setTimeout(() => {
        console.log('Displaying popup...');  // Debugging: Popup wordt getoond
        this.show();
      }, this.settings.delay);
  
      this.closeBtn.addEventListener('click', () => {
        console.log('Closing popup...');  // Debugging: Popup wordt gesloten
        this.hide();
      });
  
      this.form.addEventListener('submit', (e) => this.handleSubmit(e));
  
      this.overlay.addEventListener('click', (e) => {
        if (e.target === this.overlay) {
          console.log('Clicked outside popup, closing...');  // Debugging: Klik buiten popup
          this.hide();
        }
      });
  
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          console.log('Escape key pressed, closing popup...');  // Debugging: Escape-toets om popup te sluiten
          this.hide();
        }
      });
    }
  
    shouldShowPopup() {
      const isHomepage = document.body.classList.contains('template-index');
      console.log('Is homepage:', isHomepage);  // Debugging: Is de pagina de homepage?
    
      // De popup tonen op de juiste pagina
      if (this.settings.showOn === 'homepage' && !isHomepage) {
        console.log('Popup should only show on homepage but not on current page');  // Debugging: Alleen op homepage
        return false;
      }
    
      // Als showOn 'all_pages' is, moet de popup op alle pagina's getoond worden
      if (this.settings.showOn === 'all_pages') {
        console.log('Popup should show on all pages');  // Debugging: Popup moet op alle pagina's getoond worden
      }
    
      // Popup alleen tonen als de cookie niet aanwezig is en de popup eenmaal wordt getoond
      if (this.settings.showOnce && this.getCookie(this.settings.cookieName)) {
        console.log('Cookie present, not showing popup again');  // Debugging: Cookie aanwezig, toon de popup niet opnieuw
        return false;
      }
    
      return true;
    }    
  
    show() {
      this.scrollPos = window.scrollY;
      console.log('Scroll position:', this.scrollPos);  // Debugging: Huidige scrollpositie
  
      this.overlay.classList.add('active');
      console.log('Popup is now active');  // Debugging: Popup actief
      document.body.style.overflow = 'hidden';
      this.overlay.style.top = '0';
      this.overlay.style.position = 'fixed';
    }
  
    hide() {
      console.log('Hide called with showOnce:', this.settings.showOnce);
      this.overlay.classList.remove('active');
      document.body.style.overflow = '';
      window.scrollTo(0, this.scrollPos);
        
      if (this.settings.showOnce) {
        console.log('Setting cookie on hide');
        this.setCookie();
      } else {
        console.log('Not setting cookie because showOnce is false');
      }
    }
    
    handleSubmit(e) {
      e.preventDefault(); // We need to prevent default to handle hCaptcha
      
      // Check if hCaptcha is verified
      const hcaptchaResponse = document.querySelector('[name="h-captcha-response"]')?.value;
      
      if (!hcaptchaResponse) {
        console.log('Please complete the captcha');
        return false;
      }
      
      // Now submit the form
      const form = e.target.closest('form');
      if (form) {
        this.setCookie();
        form.submit(); // Submit the form after captcha verification
        
        // Show success message after short delay
        setTimeout(() => {
          this.showSuccess();
          setTimeout(() => this.hide(), this.settings.confirmationDuration);
        }, 500);
      }
      
      return false;
    }
  
    showSuccess() {
      console.log('Showing success message...');
      const mainContent = this.overlay.querySelector('[data-popup-main]');
      const successContent = this.overlay.querySelector('[data-popup-success]');
      
      if (mainContent && successContent) {
        mainContent.classList.add('hidden');
        successContent.classList.remove('hidden');
      } else {
        console.error('Success or main content elements not found');
      }
    }
  
    setCookie() {
      try {
        const date = new Date();
        date.setTime(date.getTime() + (this.settings.cookieDuration * 24 * 60 * 60 * 1000));
        const cookieString = `${this.settings.cookieName}=true; expires=${date.toUTCString()}; path=/`;
        document.cookie = cookieString;
        console.log('Cookie set successfully:', cookieString); // Add debugging
      } catch (error) {
        console.error('Error setting cookie:', error);
      }
    }
    
    getCookie(name) {
      console.log('Checking cookie for:', name);  // Debugging: Welke cookie wordt gecontroleerd?
    
      const match = document.cookie.match(new RegExp('(^| )' + name + '=([^;]+)'));
      
      if (match) {
        console.log('Cookie found:', match[2]);  // Debugging: Als cookie is gevonden, toon de waarde
        return match[2];
      } else {
        console.log('Cookie not found');  // Debugging: Als cookie niet is gevonden
        return null;
      }
    }       
  }
  
  // Initialize popup
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      console.log('DOM is ready, initializing NewsletterPopup...');  // Debugging: DOM geladen
      new NewsletterPopup();
    });
  } else {
    console.log('DOM already loaded, initializing NewsletterPopup...');  // Debugging: DOM al geladen
    new NewsletterPopup();
  }  
</script>

{% schema %}
{
  "name": "Newsletter Popup",
  "settings": [
    {
      "type": "header",
      "content": "Content Settings"
    },
    {
      "type": "text",
      "id": "header",
      "label": "Popup Header",
      "default": "Abonneer op onze nieuwsbrief"
    },
    {
      "type": "text",
      "id": "subheader",
      "label": "Popup Subheader",
      "default": "Meld je aan en blijf op de hoogte van de laatste aanbiedingen en nieuws."
    },
    {
      "type": "text",
      "id": "disclaimer",
      "label": "Disclaimer Text",
      "default": "Voorwaarden zijn van toepassing. Deze actie geldt alleen voor nieuwe abonnees."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Submit Button Text",
      "default": "Abonneer"
    },
    {
      "type": "header",
      "content": "Bevestiging"
    },
    {
      "type": "text",
      "id": "confirmation_title",
      "label": "Confirmation Title",
      "default": "Bedankt voor je inschrijving"
    },
    {
      "type": "richtext",
      "id": "confirmation_message",
      "label": "Confirmation Message",
      "default": "<p>Je bent succesvol ingeschreven voor de nieuwsbrief</p>"
    },
    {
      "type": "number",
      "id": "confirmation_duration",
      "label": "Confirmation Display Duration (seconds)",
      "default": 3
    },
    {
      "type": "header",
      "content": "Display Settings"
    },
    {
      "type": "select",
      "id": "show_on",
      "label": "Show Popup On",
      "options": [
        {
          "value": "homepage",
          "label": "Homepage Only"
        },
        {
          "value": "all_pages",
          "label": "All Pages"
        }
      ],
      "default": "homepage"
    },
    {
      "type": "number",
      "id": "delay",
      "label": "Delay (seconds)",
      "default": 5
    },
    {
      "type": "checkbox",
      "id": "show_once",
      "label": "Show Only Once",
      "default": true
    },
    {
      "type": "text",
      "id": "cookie_name",
      "label": "Cookie Name",
      "default": "newsletter_popup"
    },
    {
      "type": "number",
      "id": "cookie_duration",
      "label": "Cookie Duration (days)",
      "default": 30
    },
    {
      "type": "text",
      "id": "select_option",
      "label": "Default Select Option",
      "default": "Stijl Casual"
    }
  ],
  "presets": [
    {
      "name": "Newsletter Popup"
    }
  ]
}
{% endschema %}
